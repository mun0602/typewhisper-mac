  "strings": {
    "API Key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa API"
          }
        }
      }
    },
    "API keys are stored securely in the Keychain": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel werden sicher im Schlüsselbund gespeichert"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーはキーチェーンに安全に保存されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥安全存储在钥匙串中"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa API được lưu trữ an toàn trong Keychain"
          }
        }
      }
    },
    "Enhanced provides the best accuracy. Standard is faster and more cost-effective.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhanced bietet die beste Genauigkeit. Standard ist schneller und kosteneffizienter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhancedは最高の精度を提供します。Standardはより高速でコスト効率が良いです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强模式提供最佳准确度。标准模式更快且更具性价比。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nâng cao cho độ chính xác tốt nhất. Tiêu chuẩn nhanh hơn và tiết kiệm chi phí hơn."
          }
        }
      }
    },
