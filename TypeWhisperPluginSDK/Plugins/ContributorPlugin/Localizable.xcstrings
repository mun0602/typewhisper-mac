{
  "sourceLanguage": "en",
  "strings": {
    "%lld changes were sent for review.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã gửi %lld thay đổi để duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发送 %lld 项更改供审核。"
          }
        }
      }
    },
    "%lld selected": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld đã chọn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选择 %lld"
          }
        }
      }
    },
    "%lld sent": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "đã gửi %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发送 %lld"
          }
        }
      }
    },
    "Accepted": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã chấp nhận"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已接受"
          }
        }
      }
    },
    "After": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后"
          }
        }
      }
    },
    "Before": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前"
          }
        }
      }
    },
    "Both complete text versions of %lld changes will be sent for review. You can delete a submission until it is included in a validated training dataset.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả hai bản văn bản đầy đủ của %lld thay đổi sẽ được gửi để duyệt. Bạn có thể xóa bản gửi cho đến khi nó nằm trong tập dữ liệu huấn luyện đã kiểm định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这 %lld 项更改的前后完整文本都会送去审核。在纳入已验证的训练数据集之前，你可以删除提交。"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Changes": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改"
          }
        }
      }
    },
    "Collect corrections": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu thập chỉnh sửa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收集更正"
          }
        }
      }
    },
    "Contribution and privacy policy": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chính sách đóng góp và quyền riêng tư"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "贡献与隐私政策"
          }
        }
      }
    },
    "Delete correction": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa chỉnh sửa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除更正"
          }
        }
      }
    },
    "No corrections": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có chỉnh sửa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有更正"
          }
        }
      }
    },
    "Only manually changed before/after text is kept locally. Audio, target app, URL, and unchanged dictations are excluded.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ giữ trên máy phần văn bản trước/sau khi sửa tay. Âm thanh, ứng dụng đích, URL và các lần đọc chính tả không đổi bị loại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在本地保留手动修改前后的文本。音频、目标应用、URL 和未改动的听写会被排除。"
          }
        }
      }
    },
    "Preview": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem trước"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览"
          }
        }
      }
    },
    "Ready to send": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sẵn sàng gửi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备发送"
          }
        }
      }
    },
    "Refresh review status": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm mới trạng thái duyệt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新审核状态"
          }
        }
      }
    },
    "Refresh status": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm mới trạng thái"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新状态"
          }
        }
      }
    },
    "Rejected": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã từ chối"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒绝"
          }
        }
      }
    },
    "Review status updated.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã cập nhật trạng thái duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已更新审核状态。"
          }
        }
      }
    },
    "Select a change": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một thay đổi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一项更改"
          }
        }
      }
    },
    "Select for sending": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn để gửi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择以发送"
          }
        }
      }
    },
    "Send": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送"
          }
        }
      }
    },
    "Send %lld": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送 %lld"
          }
        }
      }
    },
    "Send selected changes?": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi các thay đổi đã chọn?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送所选更改？"
          }
        }
      }
    },
    "Sent · Manual review": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã gửi · Duyệt thủ công"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发送 · 人工审核"
          }
        }
      }
    },
    "Sent · Pending review": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã gửi · Chờ duyệt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发送 · 等待审核"
          }
        }
      }
    }
  },
  "version": "1.0"
}
