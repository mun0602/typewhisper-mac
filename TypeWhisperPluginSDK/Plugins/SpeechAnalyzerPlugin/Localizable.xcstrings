{
  "sourceLanguage": "en",
  "strings": {
    "Active: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブ: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活跃：%@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang hoạt động: %@"
          }
        }
      }
    },
    "Downloading language model...": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachmodell wird heruntergeladen ..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声モデルをダウンロード中..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下载语言模型..."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang tải xuống mô hình ngôn ngữ..."
          }
        }
      }
    },
    "Loading available languages...": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfügbare Sprachen werden geladen ..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能な言語を読み込み中..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载可用语言..."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang tải ngôn ngữ khả dụng..."
          }
        }
      }
    },
    "On-device speech recognition via Apple's Speech framework with streaming support. Select a language model below - only one can be active at a time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerätebasierte Spracherkennung über Apples Speech-Framework mit Streaming-Unterstützung. Wähle unten ein Sprachmodell - es kann jeweils nur eines aktiv sein."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスベースの音声認識は、AppleのSpeech-Frameworkを使用し、ストリーミングをサポートしています。下から音声モデルを選択してください。一度に1つしかアクティブにできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Apple Speech 框架实现设备端语音识别，支持流式传输。请从下方选择一个语言模型——一次仅可激活一个。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận dạng giọng nói cục bộ qua framework Speech của Apple, hỗ trợ streaming. Chọn một mô hình ngôn ngữ bên dưới - mỗi lần chỉ một mô hình hoạt động."
          }
        }
      }
    },
    "Search languages...": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachen suchen ..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語を検索..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索语言..."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm ngôn ngữ..."
          }
        }
      }
    },
    "Select": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auswählen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn"
          }
        }
      }
    },
    "Unload": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktivieren"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効化"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dỡ"
          }
        }
      }
    },
    "Loads on demand": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird bei Bedarf geladen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要時に読み込み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按需加载"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nạp khi cần"
          }
        }
      }
    },
    "Auto-unload model is set to Immediate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Modell automatisch entladen“ steht auf „Sofort“."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「モデルを自動でアンロード」が「すぐに」に設定されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动卸载模型”已设为“立即”。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động dỡ mô hình được đặt thành Ngay lập tức."
          }
        }
      }
    }
  },
  "version": "1.0"
}
