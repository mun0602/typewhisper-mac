    "Local speech-to-text using OpenAI Whisper via CoreML. 99+ languages, streaming, translation to English.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Sprache-zu-Text-Erkennung mit OpenAI Whisper via CoreML. 99+ Sprachen, Streaming, Übersetzung ins Englische."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI Whisperを介してCoreMLでローカルに音声認識を実行。99以上の言語、ストリーミング、英語への翻訳。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 CoreML 使用 OpenAI Whisper 的本地语音转文字。支持 99 种以上语言、流式传输、翻译为英语。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận diện giọng nói cục bộ bằng OpenAI Whisper qua CoreML. Hỗ trợ hơn 99 ngôn ngữ (bao gồm Tiếng Việt), truyền trực tiếp, dịch sang tiếng Anh."
          }
        }
      }
    },
