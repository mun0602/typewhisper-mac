    "Local speech-to-text by Mistral, powered by MLX on Apple Silicon. 15 languages, no API key required.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Spracherkennung von Mistral mit MLX auf Apple Silicon. 15 Sprachen, kein API-Schlüssel nötig."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Silicon向けMLXによるMistralのローカル音声認識。15言語対応。APIキー不要。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistral 本地语音转文字，基于 Apple Silicon 上的 MLX。支持 15 种语言，无需 API 密钥。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển giọng nói thành văn bản cục bộ của Mistral, chạy bằng MLX trên Apple Silicon. 15 ngôn ngữ, không cần khóa API."
          }
        }
      }
    },
