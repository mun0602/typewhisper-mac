{
  "sourceLanguage": "en",
  "strings": {
    "A token is only needed for private or gated models. It is used for this import and is not saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Token ist nur für private oder zugangsbeschränkte Modelle nötig. Es wird für diesen Import verwendet und nicht gespeichert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非公開またはアクセス制限のあるモデルにのみトークンが必要です。このインポートにのみ使用され、保存されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅私有或受限模型需要令牌。令牌仅用于此次导入，不会保存。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Token chỉ cần thiết cho các mô hình riêng tư hoặc bị giới hạn (gated). Token được dùng cho lần nhập này và không được lưu."
          }
        }
      }
    },
    "Add a model compatible with this plugin. The model is checked and loaded before the import completes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein mit diesem Plugin kompatibles Spracherkennungsmodell hinzu. Das Modell wird vor Abschluss des Imports geprüft und geladen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプラグインに対応したモデルを追加します。インポートが完了する前に、モデルの検証と読み込みが行われます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加与此插件兼容的语音识别模型。导入完成前会检查并加载模型。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm mô hình tương thích với tiện ích mở rộng này. Mô hình được kiểm tra và nạp trước khi nhập xong."
          }
        }
      }
    },
    "Auto-unload model is set to Immediate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Modell automatisch entladen“ steht auf „Sofort“."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「モデルを自動でアンロード」が「すぐに」に設定されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动卸载模型”已设为“立即”。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động dỡ mô hình được đặt thành Ngay lập tức."
          }
        }
      }
    },
    "Canary needs an explicit source language. Choose Greek or English for Sophea in Dictation settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary braucht eine konkrete Ausgangssprache. Wähle für Sophea Griechisch oder Englisch in den Diktateinstellungen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Canaryでは入力言語の指定が必要です。Sopheaを使う場合は、音声入力設定でギリシャ語または英語を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary 需要明确指定源语言。使用 Sophea 时，请在听写设置中选择希腊语或英语。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Canary cần một ngôn ngữ nguồn rõ ràng. Hãy chọn tiếng Hy Lạp hoặc tiếng Anh cho Sophea trong cài đặt Đọc chính tả."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        },
        "zh-Hans": {
