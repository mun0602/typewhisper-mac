          }
        }
      }
    },
    "Checking model compatibility…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellkompatibilität wird geprüft …"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルの互換性を確認中…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查模型兼容性…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang kiểm tra tính tương thích của mô hình…"
          }
        }
      }
    },
    "Choose Folder…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner auswählen …"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを選択…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择文件夹…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thư mục…"
          }
        }
      }
    },
    "Choose the folder containing config.json, tokenizer files and weights. TypeWhisper keeps its own copy; your original files are not changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den Ordner mit config.json, Tokenizer-Dateien und Gewichten. TypeWhisper erstellt eine eigene Kopie; deine Originaldateien bleiben unverändert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "config.json、トークナイザー、重みを含むフォルダを選択してください。TypeWhisperはコピーを保存し、元のファイルは変更しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择包含 config.json、分词器文件和权重的文件夹。TypeWhisper 会保存副本，不会修改原始文件。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thư mục chứa config.json, các tệp tokenizer và trọng số. TypeWhisper sẽ lưu bản sao riêng; các tệp gốc của bạn không bị thay đổi."
          }
        }
      }
    },
