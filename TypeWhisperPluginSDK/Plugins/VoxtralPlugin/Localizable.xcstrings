            "state": "translated",
            "value": "Hủy"
          }
        }
      }
    },
    "Cancelling…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird abgebrochen …"
          }
        },
        "ja": {
