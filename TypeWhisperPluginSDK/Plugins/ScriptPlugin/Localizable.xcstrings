    "Text is passed via stdin. Return result via stdout.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text wird über stdin übergeben. Ergebnis über stdout zurückgeben."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストはstdin経由で渡され、結果はstdout経由で返されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本通过 stdin 传入，结果通过 stdout 返回。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản được truyền qua stdin. Trả kết quả qua stdout."
          }
        }
      }
    },
    "Also run for completed Recorder transcripts": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch für fertige Recorder-Transkripte ausführen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レコーダーの完成した文字起こしにも実行"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音器转录完成后也运行脚本"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cũng chạy cho bản phiên âm hoàn tất của Trình ghi âm"
          }
        }
      }
    },
    "Recordings": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahmen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi âm"
          }
        }
      }
    },
    "Runs after saving, including retranscriptions. Receives the transcript via stdin and file paths via environment variables. Output does not change the saved transcript. Independent of rule filters.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nach dem Speichern ausgeführt, auch bei erneuter Transkription. Erhält das Transkript über stdin und Dateipfade über Umgebungsvariablen. Die Ausgabe verändert das gespeicherte Transkript nicht. Unabhängig von Regelfiltern."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存後に実行します。再文字起こしも対象です。文字起こしは標準入力、ファイルパスは環境変数で渡されます。出力は保存済み文字起こしを変更しません。ルールフィルターとは独立しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存后执行，包括重新转录。通过标准输入接收转录文本，通过环境变量接收文件路径。输出不会更改已保存的转录。不受规则筛选条件影响。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy sau khi lưu, kể cả các lần phiên âm lại. Nhận bản phiên âm qua stdin và đường dẫn tệp qua biến môi trường. Đầu ra không thay đổi bản phiên âm đã lưu. Độc lập với bộ lọc quy tắc."
          }
        }
      }
    }
  },
  "version": "1.0"
}
