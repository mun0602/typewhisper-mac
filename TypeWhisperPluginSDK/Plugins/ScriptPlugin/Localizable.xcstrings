{
  "sourceLanguage": "en",
  "strings": {
    "No rules configured.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールが設定されていません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Regeln konfiguriert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未配置规则。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa cấu hình quy tắc nào."
          }
        }
      }
    },
    "Active for all transcriptions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv für alle Transkriptionen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのテキスト転写に有効。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对所有转录生效。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng cho mọi phiên âm."
          }
        }
      }
    },
    "Add a script to process transcribed text via shell commands.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein Skript hinzu, um transkribierten Text per Shell-Befehl zu verarbeiten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリプトを追加して、シェルコマンドで転写テキストを処理します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加脚本以通过 Shell 命令处理转录的文本。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm tập lệnh để xử lý văn bản đã phiên âm bằng lệnh shell."
          }
        }
      }
    },
