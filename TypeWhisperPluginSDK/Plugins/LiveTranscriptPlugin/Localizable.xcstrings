            "value": "Breite"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宽度"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiều rộng"
          }
        }
      }
    },
    "Window size": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウサイズ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenstergröße"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口大小"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
