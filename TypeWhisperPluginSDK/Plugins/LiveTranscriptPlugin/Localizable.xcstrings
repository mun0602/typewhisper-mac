            "value": "录制快捷键"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phím tắt ghi âm"
          }
        }
      }
    },
    "Show or hide the transcript window with a keyboard shortcut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkript-Fenster mit einem Tastenkürzel ein- oder ausblenden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードショートカットでテキストウィンドウを表示または非表示にします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用键盘快捷键显示或隐藏转录窗口。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện hoặc ẩn cửa sổ phiên âm bằng phím tắt."
          }
        }
      }
    },
    "Show the transcript window automatically when recording starts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkript-Fenster automatisch bei Aufnahmestart anzeigen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音開始時にテキストウィンドウを自動で表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音开始时自动显示转录窗口。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự hiện cửa sổ phiên âm khi bắt đầu ghi âm."
          }
        }
      }
    },
    "Toggle Shortcut": {
      "localizations": {
