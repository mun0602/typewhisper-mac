    "Press a key combination...": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastenkombination drücken..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードショートカットを押してください..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下组合键..."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn tổ hợp phím..."
          }
        }
      }
    },
    "Record Shortcut": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnehmen"
          }
        },
        "ja": {
          "stringUnit": {
