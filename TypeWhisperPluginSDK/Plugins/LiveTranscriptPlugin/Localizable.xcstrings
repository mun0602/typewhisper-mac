          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiều cao"
          }
        }
      }
    },
    "Lower values keep more of the app behind the transcript visible.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値を小さくすると、文字起こしの背後にあるアプリがより透けて見えます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei niedrigeren Werten bleibt mehr von der App hinter dem Transkript sichtbar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数值越低，越能看清转录窗口后面的应用内容。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá trị càng thấp, ứng dụng phía sau bản phiên âm càng hiện rõ."
          }
        }
      }
    },
    "Width": {
      "localizations": {
