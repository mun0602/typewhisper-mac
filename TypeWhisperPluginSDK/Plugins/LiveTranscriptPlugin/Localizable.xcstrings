  "strings": {
    "Background opacity": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景の不透明度"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrunddeckkraft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "背景不透明度"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Độ mờ nền"
          }
        }
      }
    },
    "Height": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高さ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höhe"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
