          }
        }
      }
    },
    "Use an absolute path or a bare executable name instead of: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende einen absoluten Pfad oder nur den Programmnamen anstelle von: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の代わりに絶対パスまたは実行ファイル名のみを使用してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用绝对路径或单独的可执行文件名，而不是：%@"
