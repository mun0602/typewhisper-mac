    "Activity summaries never include transcripts, complete arguments, or secret values.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivitätszusammenfassungen enthalten niemals Transkripte, vollständige Argumente oder geheime Werte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティビティの概要に文字起こし、完全な引数、シークレット値は含まれません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动摘要绝不包含转录、完整参数或机密值。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tóm tắt hoạt động không bao giờ gồm bản phiên âm, đối số đầy đủ hoặc giá trị bí mật."
          }
        }
      }
    },
