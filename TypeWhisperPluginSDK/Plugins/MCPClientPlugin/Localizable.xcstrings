    "Batch raw JSON arguments must use the current batch item.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unverarbeitete JSON-Argumente im Stapelmodus müssen das aktuelle Stapelelement verwenden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッチの生 JSON 引数には現在のバッチ項目を使用する必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批处理原始 JSON 参数必须使用当前批处理项目。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đối số JSON thô hàng loạt phải dùng mục hàng loạt hiện tại."
          }
        }
      }
    },
    "Batch": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stapel"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッチ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批处理"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hàng loạt"
          }
        }
      }
    },
    "Batch mode expects a JSON array, validates all items before the first call, runs at most 100 items sequentially, and never retries writes automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Stapelmodus erwartet ein JSON-Array, validiert alle Elemente vor dem ersten Aufruf, führt höchstens 100 Elemente nacheinander aus und wiederholt Schreibvorgänge nie automatisch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッチモードは JSON 配列を受け取り、最初の呼び出し前に全項目を検証し、最大 100 項目を順番に実行します。書き込みは自動再試行されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批处理模式需要 JSON 数组，在首次调用前验证所有项目，最多按顺序运行 100 个项目，并且绝不自动重试写入。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ hàng loạt cần một mảng JSON, xác thực mọi mục trước lần gọi đầu tiên, chạy lần lượt tối đa 100 mục và không tự thử lại thao tác ghi."
          }
        }
      }
    },
    "Batch mode requires the processed workflow text to be a JSON array.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Stapelmodus erfordert, dass der verarbeitete Workflow-Text ein JSON-Array ist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッチモードでは処理済みワークフローテキストが JSON 配列である必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批处理模式要求处理后的工作流文本为 JSON 数组。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ hàng loạt yêu cầu văn bản quy trình đã xử lý phải là một mảng JSON."
          }
        }
      }
    },
