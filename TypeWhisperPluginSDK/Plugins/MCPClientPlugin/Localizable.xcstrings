{
  "sourceLanguage": "en",
  "strings": {
    "%@ is not one of the values allowed by the tool schema.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gehört nicht zu den vom Tool-Schema erlaubten Werten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はツールスキーマで許可された値ではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不是工具架构允许的值。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không phải một trong các giá trị được lược đồ công cụ cho phép."
          }
        }
      }
    },
    "%@ must be a JSON %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ muss ein JSON-Wert vom Typ %@ sein."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は JSON の %@ である必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 必须是 JSON %@。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ phải là JSON %@."
          }
        }
      }
    },
    "%@ timed out. The request was not retried.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung bei %@. Die Anfrage wurde nicht erneut gesendet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がタイムアウトしました。リクエストは再試行されませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 超时。请求未重试。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã hết thời gian. Yêu cầu không được thử lại."
          }
        }
      }
    },
    "%lld actions completed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Aktionen abgeschlossen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件のアクションが完了しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成 %lld 个操作。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã hoàn tất %lld hành động."
          }
        }
      }
    },
    "%lld of %lld actions completed; failed items: %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld von %lld Aktionen abgeschlossen; fehlgeschlagene Elemente: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld 件中 %1$lld 件のアクションが完了しました。失敗した項目: %3$@。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成 %2$lld 个操作中的 %1$lld 个；失败项目：%3$@。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã hoàn tất %lld trên %lld hành động; mục thất bại: %@."
          }
        }
      }
    },
    "Acknowledge automatic execution of this destructive tool before saving.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige vor dem Speichern die automatische Ausführung dieses destruktiven Tools."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存する前に、この破壊的ツールの自動実行を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存前请确认自动执行此破坏性工具。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác nhận thực thi tự động của công cụ phá hủy này trước khi lưu."
          }
        }
      }
    },
    "Acknowledge that TypeWhisper may launch this executable with your user permissions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige, dass TypeWhisper dieses Programm mit deinen Benutzerrechten starten darf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TypeWhisper がユーザー権限でこの実行ファイルを起動することを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认 TypeWhisper 可以使用你的用户权限启动此可执行文件。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác nhận rằng TypeWhisper có thể khởi chạy tệp thực thi này với quyền người dùng của bạn."
          }
        }
      }
    },
