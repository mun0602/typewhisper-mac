          }
        }
      }
    },
    "Enter a bearer token.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Bearer-Token ein."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearer トークンを入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 Bearer 令牌。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập token Bearer."
          }
        }
      }
    },
    "Enter a valid MCP server URL using HTTPS, or HTTP for a local address.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine gültige MCP-Server-URL mit HTTPS oder HTTP für eine lokale Adresse ein."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS、またはローカルアドレスには HTTP を使用した有効な MCP サーバー URL を入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入使用 HTTPS 的有效 MCP 服务器 URL，或为本地地址使用 HTTP。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập URL máy chủ MCP hợp lệ bằng HTTPS, hoặc HTTP cho địa chỉ cục bộ."
          }
        }
      }
    },
    "I understand that TypeWhisper will connect to this MCP server and may send configured workflow data.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich verstehe, dass TypeWhisper eine Verbindung zu diesem MCP-Server herstellt und konfigurierte Workflow-Daten senden kann."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TypeWhisper がこの MCP サーバーに接続し、設定されたワークフローデータを送信する場合があることを理解しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我了解 TypeWhisper 将连接此 MCP 服务器，并可能发送已配置的工作流数据。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi hiểu rằng TypeWhisper sẽ kết nối máy chủ MCP này và có thể gửi dữ liệu quy trình đã cấu hình."
          }
