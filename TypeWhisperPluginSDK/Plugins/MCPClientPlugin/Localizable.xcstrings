          "stringUnit": {
            "state": "translated",
            "value": "Dieses festgelegte MCP-Tool wird automatisch ausgeführt, sobald ein Workflow mit diesem Aktionsziel abgeschlossen ist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この固定 MCP ツールは、このアクションターゲットを使用するワークフローの完了時に自動実行されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此操作目标的工作流完成时，该固定 MCP 工具会自动运行。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ MCP cố định này tự động chạy mỗi khi quy trình dùng Mục tiêu hành động này hoàn tất."
          }
        }
      }
    },
    "This tool has no top-level properties to map. Use Raw JSON Arguments for complex schemas.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Tool hat keine zuzuordnenden Eigenschaften auf oberster Ebene. Verwende für komplexe Schemas unverarbeitete JSON-Argumente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このツールにはマッピング可能なトップレベルプロパティがありません。複雑なスキーマには生の JSON 引数を使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此工具没有可映射的顶层属性。复杂架构请使用原始 JSON 参数。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ này không có thuộc tính cấp cao nhất để ánh xạ. Với lược đồ phức tạp, hãy dùng Đối số JSON thô."
          }
        }
      }
    },
    "Tool": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tool"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
