    "Acknowledge that TypeWhisper may connect to this MCP server and send configured workflow data.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige, dass TypeWhisper eine Verbindung zu diesem MCP-Server herstellen und konfigurierte Workflow-Daten senden darf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TypeWhisper がこの MCP サーバーに接続し、設定されたワークフローデータを送信できることを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认 TypeWhisper 可以连接此 MCP 服务器并发送已配置的工作流数据。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác nhận TypeWhisper có thể kết nối máy chủ MCP này và gửi dữ liệu quy trình đã cấu hình."
          }
        }
      }
    },
    "Add a stdio or Streamable HTTP server to discover its tools.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen stdio- oder Streamable-HTTP-Server hinzu, um seine Tools zu finden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "stdio または Streamable HTTP サーバーを追加してツールを検出します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 stdio 或 Streamable HTTP 服务器以发现其工具。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm máy chủ stdio hoặc Streamable HTTP để khám phá công cụ của máy chủ đó."
          }
        }
      }
    },
    "Authentication": {
