    "Configure local stdio processes or remote Streamable HTTP endpoints.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguriere lokale stdio-Prozesse oder entfernte Streamable-HTTP-Endpunkte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
