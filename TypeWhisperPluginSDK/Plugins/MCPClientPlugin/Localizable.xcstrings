    "The bearer token is stored in the macOS Keychain and sent only in the Authorization header.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bearer-Token wird im macOS-Schlüsselbund gespeichert und nur im Authorization-Header gesendet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearer トークンは macOS キーチェーンに保存され、Authorization ヘッダーでのみ送信されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearer 令牌存储在 macOS 钥匙串中，并且仅通过 Authorization 标头发送。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Token Bearer được lưu trong Chuỗi khóa macOS và chỉ được gửi trong header Authorization."
          }
        }
      }
    },
    "Transport": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transport"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランスポート"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "传输方式"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phương thức truyền"
          }
        }
      }
    },
    "Use only an MCP endpoint you trust. Tool calls can include text and context mapped by your workflow action.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende nur einen vertrauenswürdigen MCP-Endpunkt. Tool-Aufrufe können Text und Kontext enthalten, die deine Workflow-Aktion zuordnet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼できる MCP エンドポイントのみを使用してください。ツール呼び出しには、ワークフローアクションでマッピングされたテキストやコンテキストが含まれる場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅使用你信任的 MCP 端点。工具调用可能包含工作流操作映射的文本和上下文。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ dùng điểm cuối MCP mà bạn tin cậy. Lệnh gọi công cụ có thể gồm văn bản và ngữ cảnh do hành động quy trình của bạn ánh xạ."
          }
        }
      }
    },
    "Add a Streamable HTTP server to discover its tools.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Streamable-HTTP-Server hinzu, um seine Tools zu finden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Streamable HTTP サーバーを追加してツールを検出します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 Streamable HTTP 服务器以发现其工具。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm máy chủ Streamable HTTP để khám phá công cụ của máy chủ đó."
          }
        }
      }
    },
    "Configure remote Streamable HTTP endpoints.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguriere entfernte Streamable-HTTP-Endpunkte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートの Streamable HTTP エンドポイントを設定します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置远程 Streamable HTTP 端点。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấu hình điểm cuối Streamable HTTP từ xa."
          }
        }
      }
    },
    "This edition of TypeWhisper can only connect to Streamable HTTP MCP servers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version von TypeWhisper kann nur Verbindungen zu Streamable-HTTP-MCP-Servern herstellen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエディションの TypeWhisper は Streamable HTTP の MCP サーバーにのみ接続できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 TypeWhisper 只能连接到 Streamable HTTP MCP 服务器。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản TypeWhisper này chỉ kết nối được với máy chủ MCP Streamable HTTP."
          }
        }
      }
    },
