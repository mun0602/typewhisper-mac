    "Paste a supported video or audio link. The add-on downloads its audio and adds it to TypeWhisper's transcription queue.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応する動画・音声のリンクを貼り付けてください。プラグインが音声をダウンロードし、TypeWhisperの文字起こし待ちの一覧に追加します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen unterstützten Video- oder Audio-Link ein. Das Add-on lädt die Audiospur herunter und fügt sie der Transkriptionswarteschlange von TypeWhisper hinzu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴受支持的视频或音频链接。附加组件会下载其音轨并添加到 TypeWhisper 的转录队列。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán liên kết video hoặc âm thanh được hỗ trợ. Tiện ích bổ sung tải xuống âm thanh và thêm vào hàng đợi chép lời của TypeWhisper."
          }
        }
      }
    },
    "Paste a video or audio link": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画・音声のリンクを貼り付け"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Video- oder Audio-Link einfügen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
