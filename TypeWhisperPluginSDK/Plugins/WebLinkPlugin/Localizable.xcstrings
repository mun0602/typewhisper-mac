{
  "sourceLanguage": "en",
  "strings": {
    "Cancel": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy"
          }
        }
      }
    },
    "Check again": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再確認"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut prüfen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检查"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra lại"
          }
        }
      }
    },
    "Download audio from a supported web link and pass it to TypeWhisper's regular file-transcription queue.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応するWebリンクから音声をダウンロードし、TypeWhisperの通常のファイル文字起こし待ちの一覧に追加します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt Audio aus einem unterstützten Weblink und übergibt es an die normale Dateitranskriptions-Warteschlange von TypeWhisper."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从受支持的网页链接下载音频，并将其添加到 TypeWhisper 的常规文件转录队列。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải xuống âm thanh từ liên kết web được hỗ trợ và đưa vào hàng đợi chép lời tệp thông thường của TypeWhisper."
          }
        }
      }
    },
    "Download complete": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード完了"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Download abgeschlossen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载完成"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải xuống hoàn tất"
          }
        }
      }
    },
    "Downloading media…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メディアをダウンロード中…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Medium wird heruntergeladen…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下载媒体…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang tải xuống phương tiện…"
          }
        }
      }
    },
    "Helper tools": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "補助ツール"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilfsprogramme"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助工具"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ hỗ trợ"
          }
        }
      }
    },
    "Homebrew found at %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にHomebrewが見つかりました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew wurde unter %@ gefunden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 找到 Homebrew。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tìm thấy Homebrew tại %@."
          }
        }
      }
    },
    "Homebrew was not found. Install the helper tools manually or install Homebrew first.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrewが見つかりません。補助ツールを手動でインストールするか、先にHomebrewをインストールしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew wurde nicht gefunden. Installiere die Hilfsprogramme manuell oder zuerst Homebrew."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到 Homebrew。请手动安装辅助工具，或先安装 Homebrew。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy Homebrew. Cài đặt công cụ hỗ trợ thủ công hoặc cài Homebrew trước."
          }
        }
      }
    },
    "Homebrew was not found. Install yt-dlp and ffmpeg manually, then check again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrewが見つかりません。yt-dlpとffmpegを手動でインストールしてから、再確認してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew wurde nicht gefunden. Installiere yt-dlp und ffmpeg manuell und prüfe danach erneut."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到 Homebrew。请手动安装 yt-dlp 和 ffmpeg，然后重新检查。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy Homebrew. Cài đặt yt-dlp và ffmpeg thủ công, rồi kiểm tra lại."
          }
        }
      }
    },
    "Homebrew will download and install: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrewが次をダウンロードしてインストールします：%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew lädt Folgendes herunter und installiert es: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 将下载并安装：%@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew sẽ tải xuống và cài đặt: %@"
          }
        }
      }
    },
    "Homebrew could not install the helper tools.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrewで補助ツールをインストールできませんでした。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew konnte die Hilfsprogramme nicht installieren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 无法安装辅助工具。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew không cài đặt được công cụ hỗ trợ."
          }
        }
      }
    },
    "Install helper tools?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "補助ツールをインストールしますか？"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilfsprogramme installieren?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装辅助工具？"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt công cụ hỗ trợ?"
          }
        }
      }
    },
    "Install missing tools with Homebrew": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不足しているツールをHomebrewでインストール"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlende Programme mit Homebrew installieren"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Homebrew 安装缺少的工具"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt công cụ còn thiếu bằng Homebrew"
          }
        }
      }
    },
    "Install with Homebrew": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrewでインストール"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Homebrew installieren"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Homebrew 安装"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt bằng Homebrew"
          }
        }
      }
    },
    "Missing helper tools: %@. Open the add-on settings to install them.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不足している補助ツール: %@。プラグイン設定を開いてインストールしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlende Hilfsprogramme: %@. Öffne die Add-on-Einstellungen, um sie zu installieren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少辅助工具：%@。请打开此附加组件的设置进行安装。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiếu công cụ hỗ trợ: %@. Mở cài đặt tiện ích bổ sung để cài."
          }
        }
      }
    },
    "No helper tool is downloaded without confirmation. Homebrew verifies and manages the installed packages.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認なしで補助ツールをダウンロードすることはありません。Homebrewがインストール済みパッケージを検証・管理します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Hilfsprogramm wird ohne Bestätigung heruntergeladen. Homebrew prüft und verwaltet die installierten Pakete."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未经确认不会下载任何辅助工具。Homebrew 会验证并管理已安装的软件包。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tải công cụ hỗ trợ nào khi chưa xác nhận. Homebrew xác minh và quản lý các gói đã cài."
          }
        }
      }
    },
    "Not installed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未インストール"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht installiert"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未安装"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa cài đặt"
          }
        }
      }
    },
    "Open Homebrew setup": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrewのセットアップを開く"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew-Einrichtung öffnen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Homebrew 设置"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở thiết lập Homebrew"
          }
        }
      }
    },
    "Ready": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備完了"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就绪"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sẵn sàng"
          }
        }
      }
    },
    "The download did not produce a supported audio or video file.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード結果に、対応する音声・動画ファイルがありませんでした。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download hat keine unterstützte Audio- oder Videodatei erzeugt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载未生成受支持的音频或视频文件。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản tải xuống không phải tệp âm thanh hoặc video được hỗ trợ."
          }
        }
      }
    },
    "The link must be a valid HTTP or HTTPS URL.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なHTTPまたはHTTPSのURLを入力してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Link muss eine gültige HTTP- oder HTTPS-URL sein."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接必须是有效的 HTTP 或 HTTPS URL。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết phải là URL HTTP hoặc HTTPS hợp lệ."
          }
        }
      }
    },
    "The media download failed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メディアのダウンロードに失敗しました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Medien-Download ist fehlgeschlagen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "媒体下载失败。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải xuống phương tiện thất bại."
          }
        }
      }
    },
    "The Web Link add-on is not active.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Web Linkプラグインが有効になっていません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Weblink-Add-on ist nicht aktiv."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Web Link 附加组件未启用。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiện ích bổ sung Liên kết web không hoạt động."
          }
        }
      }
    },
    "Transcribe Web Link…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Webリンクを文字起こし…"
          }
        },
        "de": {
