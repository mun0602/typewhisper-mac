{
  "sourceLanguage": "en",
  "strings": {
    "%lld memories stored": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu trữ %lld bộ nhớ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存储 %lld 条记忆"
          }
        }
      }
    },
    "Clear All": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa tất cả"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部清除"
          }
        }
      }
    },
    "Memories will appear here after transcriptions are processed.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ nhớ sẽ hiện ở đây sau khi bản phiên âm được xử lý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转录处理完成后，记忆会显示在这里。"
          }
        }
      }
    },
    "No Memories": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có bộ nhớ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有记忆"
          }
        }
      }
    },
    "No memories match your search.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có bộ nhớ nào khớp với tìm kiếm của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有与搜索匹配的记忆。"
          }
        }
      }
    },
    "Search memories...": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm bộ nhớ..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索记忆..."
          }
        }
      }
    }
  },
  "version": "1.0"
}
