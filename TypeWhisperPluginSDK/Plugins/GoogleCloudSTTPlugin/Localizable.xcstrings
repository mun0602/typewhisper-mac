{
  "sourceLanguage": "en",
  "strings": {
    "Cloud Speech-to-Text API is not enabled for this Google Cloud project. Enable speech.googleapis.com in Google Cloud, wait a few minutes, and retry.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Cloud Speech-to-Text API ist für dieses Google-Cloud-Projekt nicht aktiviert. Aktiviere speech.googleapis.com in Google Cloud, warte einige Minuten und versuche es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このGoogle CloudプロジェクトでCloud Speech-to-Text APIが有効になっていません。Google Cloudでspeech.googleapis.comを有効化し、数分待ってから再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Google Cloud 项目未启用 Cloud Speech-to-Text API。请在 Google Cloud 中启用 speech.googleapis.com，等待几分钟后重试。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa bật API Cloud Speech-to-Text cho dự án Google Cloud này. Hãy bật speech.googleapis.com trong Google Cloud, đợi vài phút rồi thử lại."
          }
        }
      }
    },
    "Credentials look valid and Speech-to-Text is reachable.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zugangsdaten sind gültig und Speech-to-Text ist erreichbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報は有効で、Speech-to-Textに接続できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "凭据有效，Speech-to-Text 可访问。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin xác thực có vẻ hợp lệ và Speech-to-Text truy cập được."
          }
        }
      }
    },
    "Default Language": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardsprache"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定の言語"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认语言"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngôn ngữ mặc định"
          }
        }
      }
    },
    "Google Cloud billing is not enabled for this project. Enable billing for the project and retry.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Projekt ist die Google-Cloud-Abrechnung nicht aktiviert. Aktiviere die Abrechnung für das Projekt und versuche es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロジェクトでGoogle Cloudの請求が有効になっていません。プロジェクトの請求を有効化してから再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目未启用 Google Cloud 结算功能。请为项目启用结算后重试。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa bật thanh toán Google Cloud cho dự án này. Hãy bật thanh toán cho dự án rồi thử lại."
          }
        }
      }
    },
    "Google Cloud rate-limited the request. Please wait a moment and retry.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Cloud hat die Anfrage gedrosselt. Warte kurz und versuche es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Cloudによりリクエストがレート制限されました。少し待ってから再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Cloud 对请求进行了速率限制。请稍候重试。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Cloud đã giới hạn tần suất yêu cầu. Vui lòng đợi một lát rồi thử lại."
          }
        }
      }
    },
    "Google denied access to Speech-to-Text. Make sure the API is enabled and the service account has the Cloud Speech Client role.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google hat den Zugriff auf Speech-to-Text verweigert. Stelle sicher, dass die API aktiviert ist und das Dienstkonto die Rolle „Cloud Speech Client“ besitzt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GoogleがSpeech-to-Textへのアクセスを拒否しました。APIが有効で、サービスアカウントにCloud Speech Clientロールがあることを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 拒绝对 Speech-to-Text 的访问。请确保 API 已启用且服务账户具有 Cloud Speech Client 角色。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google từ chối truy cập Speech-to-Text. Hãy đảm bảo API đã bật và tài khoản dịch vụ có vai trò Cloud Speech Client."
          }
        }
      }
    },
    "Google rejected the service-account credentials.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google hat die Dienstkonto-Zugangsdaten abgelehnt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleがサービスアカウント認証情報を拒否しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 拒绝了服务账户凭据。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google đã từ chối thông tin xác thực của tài khoản dịch vụ."
          }
        }
      }
    },
    "Google rejected the service-account credentials. Check that you pasted the full JSON key file for the correct project.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google hat die Dienstkonto-Zugangsdaten abgelehnt. Prüfe, ob du die vollständige JSON-Schlüsseldatei für das richtige Projekt eingefügt hast."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleがサービスアカウント認証情報を拒否しました。正しいプロジェクトのJSONキーファイル全体を貼り付けたか確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 拒绝了服务账户凭据。请确认您粘贴了正确项目的完整 JSON 密钥文件。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google đã từ chối thông tin xác thực của tài khoản dịch vụ. Hãy kiểm tra bạn đã dán đủ tệp khóa JSON của đúng dự án."
          }
        }
      }
    },
    "Google Speech-to-Text does not accept simple API keys. Paste a Google Cloud service-account JSON key here. Credentials are stored in the macOS Keychain.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Speech-to-Text akzeptiert keine einfachen API-Schlüssel. Füge hier den JSON-Schlüssel eines Google-Cloud-Dienstkontos ein. Die Zugangsdaten werden im macOS-Schlüsselbund gespeichert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Speech-to-Textでは単純なAPIキーは使えません。Google CloudのサービスアカウントJSONキー全体をここに貼り付けてください。認証情報はmacOSキーチェーンに保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Speech-to-Text 不接受简单的 API 密钥。请在此粘贴 Google Cloud 服务账户 JSON 密钥。凭据将存储在 macOS 钥匙串中。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Speech-to-Text không nhận khóa API đơn giản. Hãy dán khóa JSON tài khoản dịch vụ Google Cloud vào đây. Thông tin xác thực được lưu trong Chuỗi khóa macOS."
          }
        }
      }
    },
    "If TypeWhisper already passes a spoken language, that value wins. Otherwise this BCP-47 code is used for Google recognition requests.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn TypeWhisper bereits eine gesprochene Sprache übergibt, hat dieser Wert Vorrang. Andernfalls wird dieser BCP-47-Code für die Spracherkennungsanfragen an Google verwendet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TypeWhisperから発話言語が渡される場合は、その値が優先されます。それ以外の場合、このBCP-47コードがGoogle認識リクエストに使われます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 TypeWhisper 已传递口语语言，则使用该值。否则，此 BCP-47 代码将用于 Google 识别请求。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu TypeWhisper đã truyền ngôn ngữ nói, giá trị đó được ưu tiên. Nếu không, mã BCP-47 này được dùng cho các yêu cầu nhận dạng của Google."
          }
        }
      }
    },
    "Model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình"
          }
        }
      }
    },
    "No Google recognition model is selected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist kein Google-Spracherkennungsmodell ausgewählt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google認識モデルが選択されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未选择 Google 识别模型。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa chọn mô hình nhận dạng của Google."
          }
        }
      }
    },
    "No service-account JSON is configured yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist noch kein Dienstkonto-JSON konfiguriert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスアカウントJSONがまだ設定されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未配置服务账户 JSON。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa cấu hình JSON tài khoản dịch vụ."
          }
        }
      }
    },
    "Remove": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gỡ bỏ"
          }
        }
      }
    },
    "Replace Credentials": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugangsdaten ersetzen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報を置き換え"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换凭据"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay thế thông tin xác thực"
          }
        }
      }
    },
    "Save Credentials": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugangsdaten speichern"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報を保存"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存凭据"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu thông tin xác thực"
          }
        }
      }
    },
    "Service Account JSON": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dienstkonto-JSON"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスアカウントJSON"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务账户 JSON"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON tài khoản dịch vụ"
          }
        }
      }
    },
    "Stored credentials are active. Paste a new JSON key above to replace them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherten Zugangsdaten sind aktiv. Füge oben einen neuen JSON-Schlüssel ein, um sie zu ersetzen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの認証情報が有効です。置き換えるには上に新しいJSONキーを貼り付けてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存储的凭据有效。请在上面粘贴新的 JSON 密钥以替换。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin xác thực đã lưu đang dùng. Dán khóa JSON mới ở trên để thay thế."
          }
        }
      }
    },
    "Test Stored Credentials": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Zugangsdaten testen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済み認証情報をテスト"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试已存储的凭据"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra thông tin xác thực đã lưu"
          }
        }
      }
    },
    "The JSON could not be parsed. Paste the full Google service-account JSON file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das JSON konnte nicht gelesen werden. Füge die vollständige JSON-Datei des Google-Dienstkontos ein."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "JSONを解析できませんでした。GoogleサービスアカウントJSONファイル全体を貼り付けてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解析 JSON。请粘贴完整的 Google 服务账户 JSON 文件。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không phân tích được JSON. Hãy dán đủ tệp JSON tài khoản dịch vụ Google."
          }
        }
      }
    },
    "The verification audio was rejected as too large.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Audiodatei zur Überprüfung wurde als zu groß abgelehnt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証用音声が大きすぎるため拒否されました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证音频因过大被拒绝。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh xác minh bị từ chối vì quá lớn."
          }
        }
      }
    },
    "Use `default` or `command_and_search` for the broadest language coverage. The newer `latest_*` models can be more restrictive depending on language support.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende `default` oder `command_and_search`, um möglichst viele Sprachen abzudecken. Die neueren `latest_*`-Modelle können je nach Sprachunterstützung stärker eingeschränkt sein."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も広い言語対応には `default` または `command_and_search` を使ってください。新しい `latest_*` モデルは、言語サポートによって制限が強い場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 `default` 或 `command_and_search` 获得最广泛的语言覆盖。较新的 `latest_*` 模型可能因语言支持而更受限制。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng `default` hoặc `command_and_search` để phủ ngôn ngữ rộng nhất. Các mô hình `latest_*` mới hơn có thể bị hạn chế hơn tùy ngôn ngữ được hỗ trợ."
          }
        }
      }
    },
    "Validating...": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird überprüft …"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証中..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证中..."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang xác thực..."
          }
        }
      }
    }
  },
  "version": "1.0"
}
