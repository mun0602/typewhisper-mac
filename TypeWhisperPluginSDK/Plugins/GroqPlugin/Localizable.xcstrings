{
  "sourceLanguage": "en",
  "strings": {
    "Send dictionary terms": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wörterbuchbegriffe senden"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞書の用語を送信"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送词典术语"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi thuật ngữ từ điển"
          }
        }
      }
    },
    "Off by default because dictionary terms can make Groq skip parts of a dictation. Dictionary corrections after transcription apply either way.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus, weil Groq mit Wörterbuchbegriffen Teile eines Diktats auslassen kann. Wörterbuchkorrekturen nach der Transkription gelten in jedem Fall."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞書の用語を送信するとGroqが口述の一部を省略することがあるため、既定ではオフです。文字起こし後の辞書による修正は常に適用されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭，因为发送词典术语可能导致 Groq 漏掉部分听写内容。转写后的词典纠正始终生效。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt theo mặc định vì thuật ngữ từ điển có thể khiến Groq bỏ sót một phần lời đọc chính tả. Sửa theo từ điển sau phiên âm vẫn áp dụng dù bật hay tắt."
          }
        }
      }
    },
    "API Key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel"
          }
        },
        "ja": {
