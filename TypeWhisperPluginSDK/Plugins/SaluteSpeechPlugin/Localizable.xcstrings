{
  "sourceLanguage": "en",
  "strings": {
    "Authorization Key": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa ủy quyền"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权密钥"
          }
        }
      }
    },
    "Authorization Key is stored securely in the Keychain. If validation fails with a certificate error, install the SaluteSpeech certificate trusted by macOS.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa ủy quyền được lưu an toàn trong Keychain. Nếu xác thực lỗi chứng chỉ, hãy cài chứng chỉ SaluteSpeech mà macOS tin cậy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权密钥安全保存在钥匙串中。如果因证书错误而验证失败，请安装 macOS 信任的 SaluteSpeech 证书。"
          }
        }
      }
    },
    "Clear balance": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa số dư"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除余额"
          }
        }
      }
    },
    "Corporate": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Doanh nghiệp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "企业"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xong"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Local estimate. Update it from SaluteSpeech Studio.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ước tính trên máy. Hãy cập nhật từ SaluteSpeech Studio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地估算。请从 SaluteSpeech Studio 更新。"
          }
        }
      }
    },
