{
  "sourceLanguage": "en",
  "strings": {
    "%lld memories stored": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu trữ %lld bộ nhớ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存储 %lld 条记忆"
          }
        }
      }
    },
    "API Key": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa API"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥"
          }
        }
      }
    },
    "Apply Filing": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng nơi lưu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用归档位置"
          }
        }
      }
    },
    "Base URL": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "URL gốc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基础 URL"
          }
        }
      }
    },
    "Clear All": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa tất cả"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部清除"
          }
        }
      }
    },
    "Configure API key, URL, wing, and room first.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cấu hình khóa API, URL, wing và room trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先配置 API 密钥、URL、wing 和 room。"
          }
        }
      }
    },
    "Connection": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接"
          }
        }
      }
    },
    "Connection OK": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối ổn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接正常"
          }
        }
      }
    },
    "Could not apply configuration.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không áp dụng được cấu hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法应用配置。"
          }
        }
      }
    },
    "Delete failed: ": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa thất bại: "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除失败："
          }
        }
      }
    },
    "Deployment": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Triển khai"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部署"
          }
        }
      }
    },
    "Filing Location": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nơi lưu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档位置"
          }
        }
      }
    },
    "Filing saved.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu nơi lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存归档位置。"
          }
        }
      }
    },
    "Filter memories...": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lọc bộ nhớ..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "筛选记忆..."
          }
        }
      }
    },
    "No Memories": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có bộ nhớ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有记忆"
          }
        }
      }
    },
    "No memories match your filter.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có bộ nhớ nào khớp bộ lọc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有与筛选条件匹配的记忆。"
          }
        }
      }
    },
    "Paste API key": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán khóa API"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴 API 密钥"
          }
        }
      }
    },
    "Pick": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择"
          }
        }
      }
    },
    "Refresh Wings/Rooms": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm mới Wing/Room"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新 Wing/Room"
          }
        }
      }
    },
    "Room": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Room"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Room"
          }
        }
      }
    },
    "Save & Test": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu và kiểm tra"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存并测试"
          }
        }
      }
    },
    "Some deletions failed: ": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số mục xóa thất bại: "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分删除失败："
          }
        }
      }
    },
    "Stored memories appear here after transcriptions.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ nhớ đã lưu hiện ở đây sau khi phiên âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转录之后，已存储的记忆会显示在这里。"
          }
        }
      }
    },
    "Update failed: ": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật thất bại: "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新失败："
          }
        }
      }
    },
    "Wing": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Wing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wing"
          }
        }
      }
    },
    "Wing, Room, and base URL must be set.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phải đặt Wing, Room và URL gốc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须设置 Wing、Room 和基础 URL。"
          }
        }
      }
    },
    "memories": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "bộ nhớ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记忆"
          }
        }
      }
    }
  },
  "version": "1.0"
}
