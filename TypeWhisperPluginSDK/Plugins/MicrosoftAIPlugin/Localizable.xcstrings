    "Audio is sent to Microsoft Azure for transcription. API keys are stored securely in the Keychain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio wird zur Transkription an Microsoft Azure gesendet. API-Schlüssel werden sicher im Schlüsselbund gespeichert."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声は文字起こしのためMicrosoft Azureに送信されます。APIキーはキーチェーンに安全に保存されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音频会发送到 Microsoft Azure 进行转录。API 密钥安全存储在钥匙串中。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Âm thanh được gửi đến Microsoft Azure để phiên âm. Khóa API được lưu an toàn trong Chuỗi khóa."
          }
        }
      }
    },
