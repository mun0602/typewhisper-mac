    "Enter the endpoint shown for your Azure Speech resource, or only its resource name." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib den für deine Azure-Speech-Ressource angezeigten Endpunkt oder nur den Ressourcennamen ein."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azure Speechリソースに表示されるエンドポイント、またはリソース名のみを入力してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入 Azure Speech 资源显示的端点，或仅输入资源名称。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập endpoint hiển thị của tài nguyên Azure Speech, hoặc chỉ tên tài nguyên."
          }
        }
      }
    },
    "MAI Transcribe is not available in the Azure region %@. Use a Speech resource in one of these regions: %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MAI Transcribe ist in der Azure-Region %@ nicht verfügbar. Verwende eine Speech-Ressource in einer dieser Regionen: %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MAI Transcribe は Azure リージョン %@ では利用できません。次のいずれかのリージョンの Speech リソースを使用してください: %@。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MAI Transcribe 在 Azure 区域 %@ 中不可用。请使用以下区域之一的 Speech 资源：%@。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MAI Transcribe không khả dụng ở vùng Azure %@. Hãy dùng tài nguyên Speech ở một trong các vùng sau: %@."
          }
        }
      }
