        }
      }
    },
    "Models are loaded dynamically from Meta and cached for offline settings access." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelle werden dynamisch von Meta geladen und für den Offline-Zugriff in den Einstellungen zwischengespeichert."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルはMetaから動的に取得され、オフライン設定用にキャッシュされます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型从 Meta 动态加载，并会缓存，以便离线访问设置。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mô hình được tải động từ Meta và được lưu đệm để truy cập Cài đặt khi ngoại tuyến."
          }
        }
      }
    },
