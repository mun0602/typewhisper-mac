    "Realtime transcription streams 16 kHz PCM over Meta's WebSocket API. Speaker diarization applies to both realtime and uploaded audio." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Echtzeittranskription streamt 16-kHz-PCM über Metas WebSocket-API. Die Sprechererkennung gilt sowohl für Echtzeit- als auch für hochgeladene Audiodateien."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リアルタイム文字起こしはMetaのWebSocket APIを通じて16 kHz PCMをストリーミングします。話者分離はリアルタイム音声とアップロード音声の両方に適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时转录通过 Meta 的 WebSocket API 流式传输 16 kHz PCM 音频。说话人分离同时适用于实时音频和上传的音频。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên âm thời gian thực truyền luồng PCM 16 kHz qua API WebSocket của Meta. Phân tách người nói áp dụng cho cả âm thanh thời gian thực và âm thanh đã tải lên."
          }
        }
      }
    },
    "Save and Refresh Models" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
