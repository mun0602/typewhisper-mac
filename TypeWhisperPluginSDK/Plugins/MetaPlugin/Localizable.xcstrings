    },
    "Contributor models may use prompts and completions to train future Meta models." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contributor-Modelle dürfen Prompts und Antworten zum Training zukünftiger Meta-Modelle verwenden."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contributorモデルでは、将来のMetaモデルの学習にプロンプトと応答が使用される場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contributor 模型可能会使用提示词和生成内容来训练未来的 Meta 模型。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mô hình Contributor có thể dùng prompt và completion để huấn luyện các mô hình Meta sau này."
          }
        }
      }
    },
    "Meta Model API" : {
