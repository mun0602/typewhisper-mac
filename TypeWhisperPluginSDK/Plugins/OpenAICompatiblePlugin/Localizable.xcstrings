    "Choose Ollama to discover installed models through the server's native /api/tags endpoint. Generic servers only use the OpenAI-compatible /v1/models endpoint.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollamaを選ぶと、サーバー固有の/api/tagsエンドポイントからインストール済みのモデルを取得します。汎用サーバーでは、OpenAI互換の/v1/modelsエンドポイントのみを使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Ollama to discover installed models through the server's native /api/tags endpoint. Generic servers only use the OpenAI-compatible /v1/models endpoint."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 Ollama 可通过服务器原生的 /api/tags 接口发现已安装的模型。通用服务器仅使用 OpenAI 兼容的 /v1/models 接口。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn Ollama để tìm mô hình đã cài qua endpoint gốc /api/tags của máy chủ. Máy chủ tổng quát chỉ dùng endpoint /v1/models tương thích OpenAI."
          }
        }
      }
    },
    "The server URL is invalid.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーURLが無効です。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server URL is invalid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器 URL 无效。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "URL máy chủ không hợp lệ."
          }
        }
      }
    },
    "Could not reach the Ollama server. Check that it is running and the URL is correct.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollamaサーバーに接続できませんでした。サーバーが起動していることと、URLが正しいことを確認してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach the Ollama server. Check that it is running and the URL is correct."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到 Ollama 服务器。请确认其正在运行且 URL 正确。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kết nối máy chủ Ollama. Hãy kiểm tra máy chủ đang chạy và URL đúng."
          }
        }
      }
    },
    "The server rejected the request (unauthorized). Check the API key.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがリクエストを拒否しました（認証エラー）。APIキーを確認してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server rejected the request (unauthorized). Check the API key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝了请求（未授权）。请检查 API 密钥。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ từ chối yêu cầu (không được phép). Hãy kiểm tra khóa API."
          }
        }
      }
    },
    "The server returned an unexpected error.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが予期しないエラーを返しました。"
          }
