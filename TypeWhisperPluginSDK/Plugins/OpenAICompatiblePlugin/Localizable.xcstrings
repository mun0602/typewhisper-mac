          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ trả về lỗi không mong đợi."
          }
        }
      }
    },
    "The server reported no installed models. Pull a model with `ollama pull <model>` first.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーにインストール済みのモデルがありません。先に`ollama pull <model>`でモデルを取得してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server reported no installed models. Pull a model with `ollama pull <model>` first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器没有报告任何已安装的模型。请先运行 `ollama pull <model>` 拉取模型。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ báo chưa có mô hình nào được cài. Hãy tải mô hình trước bằng `ollama pull <model>`."
          }
        }
      }
    },
    "The server response was not a valid Ollama /api/tags payload.": {
      "localizations": {
