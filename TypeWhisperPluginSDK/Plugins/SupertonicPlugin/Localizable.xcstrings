    "Open Supertonic 3 OpenRAIL-M license": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenRAIL-M-Lizenz für Supertonic 3 öffnen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
