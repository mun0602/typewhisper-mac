{
  "sourceLanguage": "en",
  "strings": {
    "API Key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Key"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa API"
          }
        }
      }
    },
    "API keys are stored securely in the Keychain": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Keys werden sicher im Schlüsselbund gespeichert"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーはキーチェーンに安全に保存されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥安全存储在钥匙串中"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa API được lưu trữ an toàn trong Keychain"
          }
        }
      }
    },
    "Could not validate API Key. Check your connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Key konnte nicht geprüft werden. Prüfe die Verbindung und versuche es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーの検証に失敗しました。接続を確認し、再度試してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证 API 密钥。请检查连接后重试。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác thực khóa API. Kiểm tra kết nối rồi thử lại."
          }
        }
      }
    },
