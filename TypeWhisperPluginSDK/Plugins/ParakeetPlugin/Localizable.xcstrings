{
  "sourceLanguage": "en",
  "strings": {
    "Load": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込む"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nạp"
          }
        }
      }
    },
    "CTC model (~100 MB) - downloads automatically on first use, or:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CTC-Modell (~100 MB) - wird automatisch beim ersten Gebrauch geladen, oder:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CTCモデル (~100 MB) - 最初に使用するときに自動で読み込まれます。または:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CTC 模型（约 100 MB）- 首次使用时自动下载，或："
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình CTC (~100 MB) - tự động tải xuống khi dùng lần đầu, hoặc:"
          }
        }
      }
    },
    "Download & Load": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden & Aktivieren"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み & 有効化"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载并加载"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải xuống và nạp"
          }
        }
      }
    },
    "Download Now": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt herunterladen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐダウンロード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即下载"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải xuống ngay"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xong"
          }
        }
      }
    },
    "Downloading CTC model...": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CTC-Modell wird heruntergeladen..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CTCモデルがダウンロード中..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下载 CTC 模型..."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang tải xuống mô hình CTC..."
          }
        }
      }
    },
    "Enable Vocabulary Boosting": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vokabel-Boosting aktivieren"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "語彙ブーストを有効化"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用词汇增强"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật Tăng cường từ vựng"
          }
        }
      }
    },
    "Improves recognition of custom terms from your Dictionary using a secondary CTC model.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbessert die Erkennung von Fachbegriffen aus dem Wörterbuch mittels eines sekundären CTC-Modells."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞書の専門用語の認識を、セカンダリCTCモデルにより向上させます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用辅助 CTC 模型提高词典中自定义术语的识别率。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cải thiện nhận diện thuật ngữ tùy chỉnh từ Từ điển bằng mô hình CTC phụ."
          }
        }
      }
    },
    "Hugging Face Token": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face Token"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Faceトークン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face 令牌"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Token Hugging Face"
          }
        }
      }
    },
    "Invalid Hugging Face Token": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültiger Hugging Face Token"
          }
        },
        "ja": {
