    "calendarMeeting.permission.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper fordert vollständigen Kalenderzugriff an, um unterstützte Meeting-Links in ausgewählten Kalendern zu finden. Danach wird die Mitteilungsberechtigung für Hinweise angefragt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper will request full calendar access to find supported meeting links in your selected calendars. Notification permission is requested afterward for reminders."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したカレンダー内の対応ミーティングリンクを検出するため、カレンダーへのフルアクセスを要求します。その後、リマインダー用の通知権限を要求します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper 将请求完整日历访问权限，以便在所选日历中查找支持的会议链接。之后会请求通知权限用于提醒。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper sẽ yêu cầu toàn quyền truy cập lịch để tìm các liên kết cuộc họp được hỗ trợ trong lịch bạn đã chọn. Quyền thông báo sẽ được yêu cầu sau đó để gửi lời nhắc."
          }
        }
      }
    },
