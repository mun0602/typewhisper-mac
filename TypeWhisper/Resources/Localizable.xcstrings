      }
    },
    "Use the global spoken language setting for this context." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende die globale Einstellung für die gesprochene Sprache in diesem Kontext."
          }
        },
