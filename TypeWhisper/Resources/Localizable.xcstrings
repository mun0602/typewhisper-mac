    "Leave the model on Engine Default to follow the engine's selected model." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エンジンで選択されたモデルに従うには、モデルを「エンジンのデフォルト」のままにしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
