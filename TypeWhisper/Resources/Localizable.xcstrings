    "calendarMeeting.settings.autoStopHelp" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn das Meeting beendet scheint, zeigt die Aufnahmeanzeige einen 15-Sekunden-Countdown mit „Aufnahme fortsetzen“. macOS-Mitteilungen sind optional."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the meeting appears to have ended, the recording indicator shows a 15-second countdown with Continue recording. macOS notifications are optional."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミーティングが終了したように見えると、録音インジケーターに15秒のカウントダウンと「録音を続ける」が表示されます。macOSの通知は任意です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当会议似乎已结束时，录音指示器会显示 15 秒倒计时和“继续录音”按钮。macOS 通知不是必需的。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi cuộc họp có vẻ đã kết thúc, chỉ báo ghi âm sẽ hiển thị đếm ngược 15 giây cùng nút Tiếp tục ghi âm. Thông báo macOS là tùy chọn."
          }
        }
      }
    },
