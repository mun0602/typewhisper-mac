        }
      }
    },
    "Canary needs an explicit source language. Choose Greek or English for Sophea in Dictation settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canary braucht eine konkrete Ausgangssprache. Wähle für Sophea Griechisch oder Englisch in den Diktateinstellungen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canaryでは入力言語の指定が必要です。Sopheaを使う場合は、音声入力設定でギリシャ語または英語を選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canary 需要明确指定源语言。使用 Sophea 时，请在听写设置中选择希腊语或英语。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canary cần một ngôn ngữ nguồn rõ ràng. Hãy chọn tiếng Hy Lạp hoặc tiếng Anh cho Sophea trong cài đặt Đọc chính tả."
          }
        }
      }
    },
    "A model operation is already in progress. Wait for it to finish." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Modellvorgang läuft bereits. Warte, bis er abgeschlossen ist."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルの処理が進行中です。完了するまでお待ちください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型操作正在进行中，请等待完成。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một thao tác mô hình đang diễn ra. Vui lòng đợi hoàn tất."
          }
        }
      }
    },
    "A token is only needed for private or gated models. It is used for this import and is not saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Token ist nur für private oder zugangsbeschränkte Modelle nötig. Es wird für diesen Import verwendet und nicht gespeichert."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非公開またはアクセス制限のあるモデルにのみトークンが必要です。このインポートにのみ使用され、保存されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅私有或受限模型需要令牌。令牌仅用于此次导入，不会保存。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token chỉ cần thiết cho các mô hình riêng tư hoặc bị giới hạn (gated). Token được dùng cho lần nhập này và không được lưu."
          }
        }
      }
    },
    "Add a model compatible with an installed local engine. The model is checked and loaded before the import completes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge ein Modell für eine installierte lokale Engine hinzu. Das Modell wird vor Abschluss des Imports geprüft und geladen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール済みのローカルエンジンに対応するモデルを追加します。インポート完了前にモデルを検証して読み込みます。"
          }
        },
