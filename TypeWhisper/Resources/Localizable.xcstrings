    "Delete All History?" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Gesamten Verlauf löschen?"}},"ja":{"stringUnit":{"state":"translated","value":"すべての履歴を削除しますか？"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除所有历史记录？"}},"vi":{"stringUnit":{"state":"translated","value":"Xóa tất cả lịch sử?"}}}},
    "Delete Entry?" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Eintrag löschen?"}},"ja":{"stringUnit":{"state":"translated","value":"項目を削除しますか？"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除条目？"}},"vi":{"stringUnit":{"state":"translated","value":"Xóamục？"}}}},
