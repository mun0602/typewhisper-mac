    "Secure Input is active in %@. Standard key+modifier shortcuts should keep working. Fallback-only shortcut types may not work until that app leaves password or sensitive input." : {
      "comment" : "A warning that Secure Input is active, which can affect the functionality of the hotkeys.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 中已启用“安全输入”。标准的按键+修饰键快捷键应仍可使用。在该应用退出密码或敏感输入状态前，仅依赖备用机制的快捷键类型可能无法使用。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@でセキュア入力が有効です。通常のキーと修飾キーを組み合わせたショートカットは引き続き使えるはずです。代替方式のみを使うショートカットは、そのアプリでパスワードなどの機密情報の入力を終えるまで動作しない場合があります。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secure Input đang hoạt động trong %@. Các phím tắt phím+phím bổ trợ tiêu chuẩn vẫn sẽ hoạt động bình thường. Các loại phím tắt chỉ dự phòng có thể không hoạt động cho đến khi ứng dụng đó rời khỏi trường nhập mật khẩu hoặc dữ liệu nhạy cảm."
          }
        }
      }
    },
    "Secure sign-in data could not be generated." : {
      "comment" : "Error message when secure sign-in data could not be generated.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法生成安全登录数据。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全なサインイン用データを生成できませんでした。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể tạo dữ liệu đăng nhập an toàn."
          }
        }
      }
    },
    "See licensing on the website" : {
