          "stringUnit" : {
            "state" : "translated",
            "value" : "登录系统时，TypeWhisper 将自动启动。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper sẽ tự động khởi chạy khi bạn đăng nhập."
          }
        }
      }
    },
    "TypeWhisper works with Raycast. Start dictation and more directly from your launcher." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper funktioniert mit Raycast. Starte Diktat und mehr direkt aus deinem Launcher."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisperはRaycastと連携します。ランチャーから直接音声入力やその他の機能を起動できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper 支持 Raycast，可直接从启动器开始听写并使用更多功能。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper hoạt động với Raycast. Bắt đầu đọc chính tả và nhiều tác vụ khác ngay từ trình khởi chạy của bạn."
          }
        }
      }
    },
    "TypeWhisper works with Raycast. Start dictation and more directly from your launcher. Requires the API server to be running." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisperはRaycastと連携できます。ランチャーから直接ディクテーションなどを開始できます。APIサーバーが実行中である必要があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper 支持 Raycast，可直接从启动器开始听写并使用更多功能。使用时需要运行 API 服务器。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper hoạt động với Raycast. Bắt đầu đọc chính tả và nhiều tác vụ khác trực tiếp từ trình khởi chạy của bạn. Yêu cầu máy chủ API đang chạy."
          }
        }
      }
