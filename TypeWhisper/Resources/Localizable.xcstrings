    "This removes the account and entitlement link. Local entries and private cloud files are not deleted." : {
      "comment" : "A message displayed in a confirmation alert when the user deletes their premium account.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作会移除账户及其权益关联。本地条目和专用云端文件不会被删除。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントと利用権の紐づけを削除します。このMacの項目や非公開のクラウドファイルは削除されません。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ xóa liên kết tài khoản và quyền lợi. Các mục cục bộ và tệp đám mây riêng tư sẽ không bị xóa."
          }
        }
      }
    },
    "This rule applies across browsers based on the website. App + website is even more specific, and against other website rules the priority decides." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このルールは、Webサイトに基づいてブラウザ全体に適用されます。「アプリ + Webサイト」はさらに具体的であり、他のWebサイトルールと競合する場合は優先順位によって決定されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此规则根据网站跨浏览器生效。“应用 + 网站”规则更具体；与其他网站规则冲突时，由优先级决定。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quy tắc này áp dụng trên các trình duyệt dựa trên trang web. Ứng dụng + trang web thậm chí còn cụ thể hơn, và mức ưu tiên sẽ quyết định thứ tự áp dụng với các quy tắc trang web khác."
          }
        }
      }
    },
    "This rule applies as soon as one of the selected apps is active. Website rules are more specific, and against other app rules the priority decides." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このルールは、選択したアプリのいずれかがアクティブになるとすぐに適用されます。Webサイトルールはより具体的であり、他のアプリルールと競合する場合は優先順位によって決定されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选定的任一应用处于活动状态时，此规则即会生效。网站规则更具体；与其他应用规则冲突时，由优先级决定。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quy tắc này áp dụng ngay khi một trong các ứng dụng đã chọn đang hoạt động. Quy tắc trang web mang tính cụ thể hơn, và đối với các quy tắc ứng dụng khác, độ ưu tiên sẽ quyết định."
          }
        }
      }
    },
    "This Rule Does the Following" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このルールの実行内容"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此规则将执行以下操作"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quy tắc này thực hiện các tác vụ sau"
          }
        }
      }
    },
    "This rule is strongest when the app and website match at the same time. If multiple equally specific rules match, the higher priority wins." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このルールは、アプリとWebサイトが同時に一致する場合に最も優先度が高くなります。同じ条件のルールが複数一致した場合は、優先順位の高いものが優先されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同时匹配应用和网站时，此规则最精确。若多个同等精确的规则同时匹配，则优先级较高者生效。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quy tắc này có hiệu lực mạnh nhất khi ứng dụng và trang web khớp cùng lúc. Nếu nhiều quy tắc có độ cụ thể tương đương cùng khớp, mức ưu tiên cao hơn sẽ thắng."
          }
        }
      }
    },
    "This setting applies only when the menu bar icon is hidden." : {
