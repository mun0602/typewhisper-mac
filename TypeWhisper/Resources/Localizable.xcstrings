    "premium.window.learning.repeatCount.help" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei einer höheren Anzahl wird eine Korrektur erst im Wörterbuch gespeichert, wenn du dieselbe innerhalb von 30 Tagen so oft vorgenommen hast. Einmalige Änderungen werden ignoriert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With a higher count, a correction is only saved to the Dictionary after you have made the same correction that many times within 30 days. One-off edits are ignored."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回数を増やすと、同じ修正を30日以内にその回数行ったときにだけ辞書へ保存されます。1回限りの編集は無視されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次数设得更高时，只有在 30 天内做了相同次数的同一修正，才会保存到词典。一次性的编辑会被忽略。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Với số lần cao hơn, bản chỉnh sửa chỉ được lưu vào Từ điển sau khi bạn đã thực hiện cùng một chỉnh sửa đủ số lần đó trong vòng 30 ngày. Các chỉnh sửa một lần sẽ bị bỏ qua."
          }
        }
      }
    },
