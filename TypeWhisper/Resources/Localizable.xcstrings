        }
      }
    },
    "The source could not be read safely. Quitting the source app and trying again may help. Nothing was imported.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quelle konnte nicht sicher gelesen werden. Beende gegebenenfalls die Quell-App und versuche es erneut. Es wurde nichts importiert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全读取来源。退出来源应用后重试可能有帮助。未导入任何内容。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取込み元を安全に読み取れませんでした。元のアプリを終了して再試行してください。データは取り込まれていません。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể đọc nguồn một cách an toàn. Bạn có thể thử thoát ứng dụng nguồn và thử lại. Không có nội dung nào được nhập."
          }
        }
      }
    },
    "The source exceeds the import limits. Nothing was imported.": {
