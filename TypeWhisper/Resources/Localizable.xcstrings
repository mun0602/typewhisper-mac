    "Off by default for compatibility with existing local integrations. New clients can use api-discovery.json or send the bearer token." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既存のローカル連携との互換性のため、デフォルトではオフです。新しいクライアントは api-discovery.json を使うか、Bearerトークンを送信できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认关闭，以与现有本地集成保持兼容。新客户端可以使用 api-discovery.json 或发送 Bearer 令牌。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mặc định tắt để tương thích với các tích hợp cục bộ hiện có. Client mới có thể dùng api-discovery.json hoặc gửi bearer token."
          }
        }
      }
    },
