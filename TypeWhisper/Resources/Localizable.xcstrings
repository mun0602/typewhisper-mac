        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレミアム利用権の署名を検証できませんでした。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể xác minh chữ ký quyền lợi Premium."
          }
        }
      }
    },
    "The private sync folder was deleted. Local data was kept." : {
      "comment" : "Message displayed when the user deletes the private sync folder.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
