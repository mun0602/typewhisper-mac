    "Changes Unavailable" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Änderungen nicht verfügbar"}},"ja":{"stringUnit":{"state":"translated","value":"変更を表示できません"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法显示更改"}},"vi":{"stringUnit":{"state":"translated","value":"Thay đổi không khả dụng"}}}},
    "Choose an entry to read its text, audio, and details." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wähle einen Eintrag aus, um Text, Audio und Details anzuzeigen."}},"ja":{"stringUnit":{"state":"translated","value":"テキスト、音声、詳細を表示する項目を選択してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择一个条目以查看文本、音频和详细信息。"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn một mục để xem văn bản, âm thanh và chi tiết."}}}},
    "Copy, export, complete, reopen, or delete the selected entries." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Ausgewählte Einträge kopieren, exportieren, abschließen, erneut öffnen oder löschen."}},"ja":{"stringUnit":{"state":"translated","value":"選択した項目をコピー、書き出し、完了、再開、削除できます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可以复制、导出、完成、重新打开或删除所选条目。"}},"vi":{"stringUnit":{"state":"translated","value":"Sao chép, xuất, hoàn tất, mở lại hoặc xóa các mục đã chọn."}}}},
    "Corrections added to the dictionary" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Korrekturen zum Wörterbuch hinzugefügt"}},"ja":{"stringUnit":{"state":"translated","value":"修正を辞書に追加しました"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已将更正添加到词典"}},"vi":{"stringUnit":{"state":"translated","value":"Đã thêm các mục sửa lỗi vào từ điển"}}}},
