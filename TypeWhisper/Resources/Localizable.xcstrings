          }
        }
      }
    },
    "TypeWhisper can watch the target text field briefly after direct dictation insertion and learn only confident corrections. Ambiguous edits are skipped." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper kann das Ziel-Textfeld kurz nach direktem Diktat-Einfügen beobachten und nur sichere Korrekturen lernen. Uneindeutige Bearbeitungen werden übersprungen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper 可在直接听写插入后短暂监视目标文本框，仅学习明确可信的纠正。含义不明确的编辑会被跳过。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisperは音声入力を直接挿入した後、入力欄を短時間確認し、確実に判断できる修正のみを学習します。判断が曖昧な編集は学習しません。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper có thể theo dõi nhanh trường văn bản đích sau khi chèn đọc chính tả trực tiếp và chỉ học các chỉnh sửa đáng tin cậy. Các chỉnh sửa không rõ ràng sẽ bị bỏ qua."
          }
        }
      }
    },
    "TypeWhisper Dev" : {
      "comment" : "The name of the app in development mode.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
