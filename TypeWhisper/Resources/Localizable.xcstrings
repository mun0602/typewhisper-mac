            "state" : "translated",
            "value" : "有効にする"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật"
          }
        }
      }
    },
    "Setting up..." : {
      "comment" : "Progress text while a transcription engine enables its dictionary Terms setting.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird eingerichtet..."
