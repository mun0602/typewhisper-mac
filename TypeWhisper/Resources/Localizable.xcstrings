    "Downloading and verifying audio…" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audio wird geladen und überprüft …"}},"ja":{"stringUnit":{"state":"translated","value":"音声をダウンロードして検証中…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在下载并验证音频…"}},"vi":{"stringUnit":{"state":"translated","value":"Đang tải xuống và xác minh âm thanh…"}}}},
