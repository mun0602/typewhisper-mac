    },
    "No Synced Devices" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine synchronisierten Geräte"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期されたデバイスはありません"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有已同步的设备"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa có thiết bị đồng bộ nào"
          }
        }
      }
    },
    "Devices appear here after their first successful sync." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geräte erscheinen hier nach ihrer ersten erfolgreichen Synchronisierung."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスは最初の同期が完了するとここに表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备首次成功同步后会显示在这里。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các thiết bị sẽ hiển thị ở đây sau lần đồng bộ thành công đầu tiên."
          }
        }
      }
    },
    "Removing a device only removes it from this list. Synced entries stay available, and the device appears again if it syncs later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du ein Gerät entfernst, wird es nur aus dieser Liste entfernt. Synchronisierte Einträge bleiben verfügbar und das Gerät erscheint wieder, sobald es erneut synchronisiert."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスを削除しても、このリストから外れるだけです。同期済みの項目は残り、デバイスが再び同期すると再表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除设备只会将其从此列表中移除。已同步的条目仍然可用，设备再次同步时会重新出现。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa thiết bị chỉ loại bỏ khỏi danh sách này. Các mục đã đồng bộ vẫn được giữ lại và thiết bị sẽ xuất hiện lại nếu đồng bộ sau này."
          }
        }
      }
    },
