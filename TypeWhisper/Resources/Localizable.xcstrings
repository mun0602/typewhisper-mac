    "Filter History" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verlauf filtern"}},"ja":{"stringUnit":{"state":"translated","value":"履歴を絞り込む"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"筛选历史记录"}},"vi":{"stringUnit":{"state":"translated","value":"LọcLịch sử"}}}},
    "Final" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Final"}},"ja":{"stringUnit":{"state":"translated","value":"最終版"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最终版本"}},"vi":{"stringUnit":{"state":"translated","value":"Bản cuối"}}}},
    "History & Sync" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verlauf & Sync"}},"ja":{"stringUnit":{"state":"translated","value":"履歴と同期"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"历史记录与同步"}},"vi":{"stringUnit":{"state":"translated","value":"Lịch sử & Đồng bộ"}}}},
