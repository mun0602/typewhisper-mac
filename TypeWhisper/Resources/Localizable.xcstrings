    "This keeps all synchronized entries. If the device syncs again, it will reappear in the list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle synchronisierten Einträge bleiben erhalten. Wenn das Gerät erneut synchronisiert, erscheint es wieder in der Liste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期済みの項目はすべて残ります。デバイスが再び同期すると、リストに再表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有已同步的条目都会保留。设备再次同步时，会重新出现在列表中。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này vẫn giữ lại tất cả các mục đã đồng bộ. Nếu thiết bị đồng bộ lại, nó sẽ xuất hiện lại trong danh sách."
          }
        }
      }
    },
    "Remove this device from the sync list?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät aus der Synchronisierungsliste entfernen?"
