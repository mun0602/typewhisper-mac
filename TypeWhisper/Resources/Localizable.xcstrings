    "Sync data stays in your selected cloud location and never passes through the TypeWhisper account service." : {
      "comment" : "A description of how data is synced to iCloud.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步数据保存在您选择的云端位置，且绝不会经过 TypeWhisper 账户服务。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期データは選択したクラウドの保存先に保管され、TypeWhisperのアカウントサービスを経由しません。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu đồng bộ sẽ nằm trong vị trí đám mây bạn đã chọn và không bao giờ đi qua dịch vụ tài khoản TypeWhisper."
          }
        }
      }
    },
    "Sync dictionaries and snippets through your own iCloud Drive, Dropbox, OneDrive, Syncthing, or custom folder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisiere Wörterbücher und Snippets über dein eigenes iCloud Drive, Dropbox, OneDrive, Syncthing oder einen eigenen Ordner."
