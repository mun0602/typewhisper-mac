        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音已保存到“听写恢复”。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản ghi âm đã được lưu vào Khôi phục đọc chính tả."
          }
        }
