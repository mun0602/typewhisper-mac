    "calendarMeeting.settings.privacy" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalenderdaten bleiben auf diesem Mac. TypeWhisper erkennt nur, ob Meeting-Audio oder eine Kamera aktiv ist, und liest keine Audio- oder Bildinhalte. Titel werden nur in lokalen Mitteilungen, Einstellungen und Dateinamen verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendar data stays on this Mac. TypeWhisper detects only whether meeting audio or a camera is active and never reads audio or video content. Titles are used only in local notifications, settings, and recording filenames."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダーデータはこのMacにのみ保存されます。TypeWhisperはミーティング音声またはカメラが使用中かどうかだけを検出し、音声や映像の内容を読み取りません。タイトルはローカル通知、設定、録音ファイル名にのみ使用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日历数据保留在这台 Mac 上。TypeWhisper 只检测会议音频或摄像头是否处于活动状态，不会读取音频或视频内容。标题仅用于本地通知、设置和录音文件名。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu lịch vẫn ở trên máy Mac này. TypeWhisper chỉ phát hiện xem âm thanh cuộc họp hoặc camera có đang hoạt động hay không và không bao giờ đọc nội dung âm thanh hoặc video. Tiêu đề chỉ được sử dụng trong các thông báo cục bộ, cài đặt và tên tệp ghi âm."
          }
        }
      }
    },
    "calendarMeeting.settings.notificationHelp" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Erinnerungsmodus benötigt macOS-Mitteilungen. Automatische Aufnahmen und der Stopp-Countdown in der App funktionieren auch ohne sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reminder mode needs macOS notifications. Automatic recording and the in-app stop countdown also work without them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知モードにはmacOSの通知許可が必要です。自動録音とアプリ内の停止カウントダウンは、通知なしでも動作します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提醒模式需要 macOS 通知。自动录音和应用内的停止倒计时无需通知也能正常运行。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chế độ nhắc nhở cần thông báo macOS. Tính năng tự động ghi âm và đếm ngược dừng trong ứng dụng vẫn hoạt động mà không cần thông báo."
          }
        }
      }
    },
