        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper cần quyền truy cập để hoạt động trên máy Mac của bạn."
          }
        }
      }
    },
    "TypeWhisper only inserts the dictated text." : {
      "localizations" : {
        "ja" : {
