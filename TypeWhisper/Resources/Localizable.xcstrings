    "Still discards accidental ultra-short taps, but keeps more very short or quiet recordings instead of classifying them as no speech." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誤操作による極端に短いタップは引き続き破棄しますが、ごく短い録音や小さな音声を無音として分類せず、より多く保持します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仍然会丢弃意外的超短按键录音，但会保留更多极短或音量很低的录音，而不是将其归类为无语音。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vẫn loại bỏ các lần chạm cực ngắn do vô tình, nhưng giữ lại nhiều bản ghi rất ngắn hoặc nhỏ tiếng hơn thay vì phân loại chúng là không có giọng nói."
          }
        }
      }
    },
