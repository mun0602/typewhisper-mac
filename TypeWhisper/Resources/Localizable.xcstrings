    "calendarMeeting.settings.detectAdHoc" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anrufe ohne Kalendertermin erkennen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detect calls without a calendar event"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダーにない通話を検出"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测没有日历事件的通话"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phát hiện các cuộc gọi không có sự kiện lịch"
          }
        }
      }
    },
    "calendarMeeting.settings.detectAdHocHelp" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkennt auch Mikrofonaktivität von Zoom und Teams sowie Browser-Meetings wie Google Meet, auch in Hintergrund-Tabs. Kalenderzugriff ist optional. Der gewählte Startmodus und die ausgewählten Anbieter gelten auch für diese Anrufe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also detect Zoom and Teams microphone activity and browser meetings such as Google Meet, even in background tabs. Calendar access is optional. The selected start mode and providers apply to these calls too."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZoomとTeamsのマイク使用、およびバックグラウンドのタブを含むGoogle Meetなどのブラウザでのミーティングも検出します。カレンダーへのアクセスは任意です。選択した開始モードとサービスはこれらの通話にも適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同时检测 Zoom 和 Teams 的麦克风活动，以及 Google Meet 等浏览器会议，包括后台标签页。无需授予日历访问权限。所选的启动模式和服务也适用于这些通话。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồng thời phát hiện hoạt động micrô của Zoom và Teams cũng như các cuộc họp trên trình duyệt như Google Meet, ngay cả trong các tab nền. Quyền truy cập Lịch là tùy chọn. Chế độ bắt đầu và các nhà cung cấp đã chọn cũng áp dụng cho các cuộc gọi này."
          }
        }
      }
    },
    "calendarMeeting.settings.autoStopNotificationsOptional" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Mitteilungen bleibt „Aufnahme fortsetzen“ in der Aufnahmeanzeige verfügbar. Sie wird während des Countdowns auch dann eingeblendet, wenn sie sonst ausgeblendet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without notifications, Continue recording remains available in the recording indicator, which is shown during the countdown even if normally hidden."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知がなくても、録音インジケーターの「録音を続ける」を使用できます。通常は非表示でも、カウントダウン中は表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使没有通知，仍可在录音指示器中选择“继续录音”。即使平时隐藏，指示器也会在倒计时期间显示。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu không có thông báo, tùy chọn Tiếp tục ghi âm vẫn khả dụng trong chỉ báo ghi âm, vốn được hiển thị trong thời gian đếm ngược ngay cả khi bình thường bị ẩn."
          }
        }
      }
    },
    "calendarMeeting.settings.adHocAutoStopHelp" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Anrufen ohne Kalendertermin beginnt der Stopp-Countdown erst nach 90 Sekunden ohne Meeting-Audio. Kurze Unterbrechungen beenden die Aufnahme dadurch nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calls without a calendar event allow 90 seconds without meeting audio before the stop countdown begins, so brief interruptions do not end the recording."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダーにない通話では、ミーティング音声が90秒間使用されなくなってから停止カウントダウンが始まるため、短い中断で録音が終了することはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于没有日历事件的通话，连续 90 秒未检测到会议音频活动后，才会开始停止录音的倒计时，避免短暂中断导致录音结束。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các cuộc gọi không có sự kiện lịch cho phép 90 giây không có âm thanh cuộc họp trước khi bắt đầu đếm ngược dừng, nhờ đó những gián đoạn ngắn sẽ không làm dừng bản ghi."
          }
        }
      }
    },
