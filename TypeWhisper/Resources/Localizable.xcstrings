        }
      }
    },
    "TypeWhisper stays in the menu bar and hides its Dock icon while no window is open." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper bleibt in der Menüleiste und blendet sein Dock-Symbol aus, solange kein Fenster geöffnet ist."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisperはメニューバーに表示され、ウィンドウが開いていない間はドックのシンボルを非表示にします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有窗口打开时，TypeWhisper 会保留在菜单栏中并隐藏程序坞图标。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper sẽ duy trì trên thanh menu và ẩn biểu tượng Dock khi không có cửa sổ nào mở."
          }
        }
      }
    },
    "TypeWhisper user data is unavailable." : {
      "localizations" : {
