        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ xóa vĩnh viễn số liệu thống kê tổng hợp về từ ngữ, ứng dụng, thời gian tiết kiệm được và hoạt động. Các mục lịch sử bản chép lời sẽ không thay đổi."
          }
