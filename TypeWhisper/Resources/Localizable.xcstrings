    "premium.window.access.linkDescription" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Commercial-Lizenz ist auf diesem Mac aktiv, aber noch nicht mit diesem Konto verknüpft. Verknüpfe sie, um die geräteübergreifende Synchronisierung freizuschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Commercial license is active on this Mac but is not linked to this account yet. Link it to enable cross-device sync."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacではCommercialライセンスが有効ですが、このアカウントにはまだ連携されていません。連携するとデバイス間同期を利用できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 上的商业许可证已激活，但尚未关联到此账户。关联后即可启用跨设备同步。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giấy phép Commercial của bạn đang hoạt động trên máy Mac này nhưng chưa được liên kết với tài khoản này. Hãy liên kết để bật đồng bộ giữa các thiết bị."
          }
        }
      }
    },
