        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过你自己的 iCloud Drive、Dropbox、OneDrive、Syncthing 或自定义文件夹同步词典和快捷短语。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分のiCloud Drive、Dropbox、OneDrive、Syncthing、または任意のフォルダを使って、辞書とスニペットを同期します。"
