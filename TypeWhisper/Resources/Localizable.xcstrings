    "Restore & Delete" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wiederherstellen & Löschen"}},"ja":{"stringUnit":{"state":"translated","value":"復元と削除"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"恢复与删除"}},"vi":{"stringUnit":{"state":"translated","value":"Khôi phục & Xóa"}}}},
    "Restore Automatically Removed History" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Automatisch entfernten Verlauf wiederherstellen"}},"ja":{"stringUnit":{"state":"translated","value":"自動削除された履歴を復元"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"恢复自动移除的历史记录"}},"vi":{"stringUnit":{"state":"translated","value":"Khôi phục lịch sử đã tự động xóa"}}}},
    "Restoring re-imports synchronized entries removed only by local retention. Deleting history while sync is enabled removes it from all synchronized devices." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Beim Wiederherstellen werden synchronisierte Einträge erneut importiert, die nur durch die lokale Aufbewahrung entfernt wurden. Wenn Sync aktiv ist, wird gelöschter Verlauf von allen synchronisierten Geräten entfernt."}},"ja":{"stringUnit":{"state":"translated","value":"復元すると、ローカルの保存期間によってのみ削除された同期済み項目が再度読み込まれます。同期中に履歴を削除すると、すべての同期デバイスから削除されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"恢复会重新导入仅因本地保留策略而移除的已同步条目。启用同步时删除历史记录，会将其从所有已同步设备中移除。"}},"vi":{"stringUnit":{"state":"translated","value":"Khôi phục sẽ nhập lại các mục đã đồng bộ chỉ bị xóa do thời gian lưu giữ cục bộ. Xóa lịch sử khi đang bật đồng bộ sẽ xóa lịch sử khỏi tất cả các thiết bị đã đồng bộ."}}}},
    "Search History" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verlauf durchsuchen"}},"ja":{"stringUnit":{"state":"translated","value":"履歴を検索"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"搜索历史记录"}},"vi":{"stringUnit":{"state":"translated","value":"Tìm kiếmLịch sử"}}}},
    "Search, review, edit, export, and complete Inbox entries in a dedicated window." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Posteingangseinträge in einem eigenen Fenster suchen, prüfen, bearbeiten, exportieren und abschließen."}},"ja":{"stringUnit":{"state":"translated","value":"専用ウインドウで受信箱の項目を検索、確認、編集、書き出し、完了できます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在专用窗口中搜索、检查、编辑、导出和完成收件箱条目。"}},"vi":{"stringUnit":{"state":"translated","value":"Tìm kiếm, xem lại, chỉnh sửa, xuất và hoàn thành các mục trong Hộp thư đến trong một cửa sổ riêng."}}}},
    "Select an Entry" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Eintrag auswählen"}},"ja":{"stringUnit":{"state":"translated","value":"項目を選択"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择一个条目"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn một mục"}}}},
    "Shortcuts" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Kurzbefehle"}},"ja":{"stringUnit":{"state":"translated","value":"ショートカット"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"快捷指令"}},"vi":{"stringUnit":{"state":"translated","value":"Phím tắt"}}}},
    "Sort" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sortieren"}},"ja":{"stringUnit":{"state":"translated","value":"並べ替え"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"排序"}},"vi":{"stringUnit":{"state":"translated","value":"Sắp xếp"}}}},
    "Sort History" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verlauf sortieren"}},"ja":{"stringUnit":{"state":"translated","value":"履歴を並べ替え"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"历史记录排序"}},"vi":{"stringUnit":{"state":"translated","value":"Sắp xếp lịch sử"}}}},
    "Sources" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Quellen"}},"ja":{"stringUnit":{"state":"translated","value":"ソース"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"来源"}},"vi":{"stringUnit":{"state":"translated","value":"Nguồn"}}}},
    "Sync Audio for New Entries" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Audio für neue Einträge synchronisieren"}},"ja":{"stringUnit":{"state":"translated","value":"新しい項目の音声を同期"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"同步新条目的音频"}},"vi":{"stringUnit":{"state":"translated","value":"Đồng bộ âm thanh cho các mục mới"}}}},
    "Sync History & Inbox" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verlauf & Posteingang synchronisieren"}},"ja":{"stringUnit":{"state":"translated","value":"履歴と受信箱を同期"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"同步历史记录和收件箱"}},"vi":{"stringUnit":{"state":"translated","value":"Đồng bộ lịch sử & hộp thư đến"}}}},
    "Sync History & Inbox?" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verlauf & Posteingang synchronisieren?"}},"ja":{"stringUnit":{"state":"translated","value":"履歴と受信箱を同期しますか？"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"同步历史记录和收件箱？"}},"vi":{"stringUnit":{"state":"translated","value":"Đồng bộ Lịch sử & Hộp thư đến?"}}}},
    "Synchronized" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Synchronisiert"}},"ja":{"stringUnit":{"state":"translated","value":"同期済み"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已同步"}},"vi":{"stringUnit":{"state":"translated","value":"Đã đồng bộ"}}}},
    "Text Version" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Textversion"}},"ja":{"stringUnit":{"state":"translated","value":"テキスト版"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"文本版本"}},"vi":{"stringUnit":{"state":"translated","value":"Phiên bản văn bản"}}}},
    "The origin device could not finish this transcription." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Ursprungsgerät konnte diese Transkription nicht abschließen."}},"ja":{"stringUnit":{"state":"translated","value":"作成元のデバイスでこの文字起こしを完了できませんでした。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"来源设备无法完成此转录。"}},"vi":{"stringUnit":{"state":"translated","value":"Thiết bị nguồn không thể hoàn tất bản chép lời này."}}}},
    "The result will update here automatically." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Ergebnis wird hier automatisch aktualisiert."}},"ja":{"stringUnit":{"state":"translated","value":"結果はここで自動的に更新されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"结果会在此处自动更新。"}},"vi":{"stringUnit":{"state":"translated","value":"Kết quả sẽ tự động cập nhật tại đây."}}}},
    "The synchronized audio could not be verified." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das synchronisierte Audio konnte nicht überprüft werden."}},"ja":{"stringUnit":{"state":"translated","value":"同期した音声を検証できませんでした。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法验证已同步的音频。"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể xác minh âm thanh đã đồng bộ."}}}},
    "The synchronized audio is not available yet." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das synchronisierte Audio ist noch nicht verfügbar."}},"ja":{"stringUnit":{"state":"translated","value":"同期した音声はまだ利用できません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已同步的音频尚不可用。"}},"vi":{"stringUnit":{"state":"translated","value":"Âm thanh đã đồng bộ hiện chưa khả dụng."}}}},
    "The synchronized audio reference is invalid." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Verweis auf das synchronisierte Audio ist ungültig."}},"ja":{"stringUnit":{"state":"translated","value":"同期した音声の参照が無効です。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已同步音频的引用无效。"}},"vi":{"stringUnit":{"state":"translated","value":"Tham chiếu âm thanh đã đồng bộ không hợp lệ."}}}},
    "This Mac" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieser Mac"}},"ja":{"stringUnit":{"state":"translated","value":"このMac"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此 Mac"}},"vi":{"stringUnit":{"state":"translated","value":"Mac này"}}}},
    "This Month" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieser Monat"}},"ja":{"stringUnit":{"state":"translated","value":"今月"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本月"}},"vi":{"stringUnit":{"state":"translated","value":"Tháng này"}}}},
    "This deletes all history from every synchronized device. This cannot be undone." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dadurch wird der gesamte Verlauf von allen synchronisierten Geräten gelöscht. Dies kann nicht rückgängig gemacht werden."}},"ja":{"stringUnit":{"state":"translated","value":"すべての同期デバイスから履歴がすべて削除されます。この操作は取り消せません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这会从所有已同步设备中删除全部历史记录，且无法撤销。"}},"vi":{"stringUnit":{"state":"translated","value":"Thao tác này sẽ xóa toàn bộ lịch sử khỏi mọi thiết bị được đồng bộ. Không thể hoàn tác thao tác này."}}}},
    "This deletes all history stored on this Mac. This cannot be undone." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dadurch wird der gesamte auf diesem Mac gespeicherte Verlauf gelöscht. Dies kann nicht rückgängig gemacht werden."}},"ja":{"stringUnit":{"state":"translated","value":"このMacに保存された履歴がすべて削除されます。この操作は取り消せません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这会删除此 Mac 上存储的全部历史记录，且无法撤销。"}},"vi":{"stringUnit":{"state":"translated","value":"Thao tác này sẽ xóa toàn bộ lịch sử được lưu trên máy Mac này. Không thể hoàn tác."}}}},
    "This entry is too long to compare word by word. Use Final or Original to read the full text." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieser Eintrag ist zu lang für einen wortweisen Vergleich. Verwende „Final“ oder „Original“, um den vollständigen Text zu lesen."}},"ja":{"stringUnit":{"state":"translated","value":"この項目は長すぎるため、単語単位で比較できません。全文を読むには「最終版」または「オリジナル」を使用してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此条目过长，无法逐词比较。请使用“最终版本”或“原始版本”阅读全文。"}},"vi":{"stringUnit":{"state":"translated","value":"Mục này quá dài để so sánh từng từ. Dùng Bản cuối hoặc Bản gốc để đọc toàn bộ văn bản."}}}},
    "This removes the selected history from every synchronized device. This cannot be undone." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dadurch wird der ausgewählte Verlauf von allen synchronisierten Geräten entfernt. Dies kann nicht rückgängig gemacht werden."}},"ja":{"stringUnit":{"state":"translated","value":"選択した履歴がすべての同期デバイスから削除されます。この操作は取り消せません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这会从所有已同步设备中移除所选历史记录，且无法撤销。"}},"vi":{"stringUnit":{"state":"translated","value":"Thao tác này sẽ xóa lịch sử đã chọn khỏi mọi thiết bị được đồng bộ. Hành động này không thể hoàn tác."}}}},
    "This removes the selected history from this Mac. This cannot be undone." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dadurch wird der ausgewählte Verlauf von diesem Mac entfernt. Dies kann nicht rückgängig gemacht werden."}},"ja":{"stringUnit":{"state":"translated","value":"選択した履歴がこのMacから削除されます。この操作は取り消せません。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这会从此 Mac 中移除所选历史记录，且无法撤销。"}},"vi":{"stringUnit":{"state":"translated","value":"Thao tác này sẽ xóa lịch sử đã chọn khỏi máy Mac này. Không thể hoàn tác."}}}},
    "With Audio" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mit Audio"}},"ja":{"stringUnit":{"state":"translated","value":"音声あり"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"含音频"}},"vi":{"stringUnit":{"state":"translated","value":"Kèm âm thanh"}}}},
    "Your saved text and Inbox state will be added to your private sync folder and become available on your other enabled TypeWhisper devices." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Gespeicherter Text und der Posteingangsstatus werden deinem privaten Sync-Ordner hinzugefügt und auf deinen anderen aktivierten TypeWhisper-Geräten verfügbar."}},"ja":{"stringUnit":{"state":"translated","value":"保存済みのテキストと受信箱の状態がプライベート同期フォルダに追加され、有効化した他のTypeWhisperデバイスでも利用できるようになります。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已保存的文本和收件箱状态将添加到你的私人同步文件夹，并可在其他已启用的 TypeWhisper 设备上使用。"}},"vi":{"stringUnit":{"state":"translated","value":"Văn bản đã lưu và trạng thái Hộp thư đến của bạn sẽ được thêm vào thư mục đồng bộ riêng tư và khả dụng trên các thiết bị TypeWhisper đã bật khác của bạn."}}}},
    "Your saved transcriptions will appear here." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Deine gespeicherten Transkriptionen erscheinen hier."}},"ja":{"stringUnit":{"state":"translated","value":"保存した文字起こしがここに表示されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你保存的转录会显示在这里。"}},"vi":{"stringUnit":{"state":"translated","value":"Các bản chép lời đã lưu của bạn sẽ xuất hiện tại đây."}}}},
    "iPhone & iPad" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"iPhone & iPad"}},"ja":{"stringUnit":{"state":"translated","value":"iPhoneとiPad"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"iPhone 和 iPad"}},"vi":{"stringUnit":{"state":"translated","value":"iPhone & iPad"}}}},
    "Choose an entry to read and edit its text or inspect its details." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wähle einen Eintrag aus, um seinen Text zu lesen und zu bearbeiten oder seine Details anzusehen."}},"ja":{"stringUnit":{"state":"translated","value":"項目を選択してテキストを読んだり編集したり、詳細を確認したりできます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择一个条目以阅读和编辑文本，或查看其详细信息。"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn một mục để đọc và chỉnh sửa văn bản hoặc xem chi tiết."}}}},
    "Device" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Gerät"}},"ja":{"stringUnit":{"state":"translated","value":"デバイス"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设备"}},"vi":{"stringUnit":{"state":"translated","value":"Thiết bị"}}}},
    "Failed" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Fehlgeschlagen"}},"ja":{"stringUnit":{"state":"translated","value":"失敗"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"失败"}},"vi":{"stringUnit":{"state":"translated","value":"Thất bại"}}}},
    "Failed imports and transcriptions will appear here." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Fehlgeschlagene Importe und Transkriptionen erscheinen hier."}},"ja":{"stringUnit":{"state":"translated","value":"失敗した読み込みと文字起こしがここに表示されます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"失败的导入和转录会显示在这里。"}},"vi":{"stringUnit":{"state":"translated","value":"Các lần nhập và bản chép lời không thành công sẽ xuất hiện tại đây."}}}},
    "History sync is optional on each device. Audio sync applies to new entries and downloads automatically on enabled devices." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Verlaufssync ist auf jedem Gerät optional. Audiosync gilt für neue Einträge und lädt Audio auf aktivierten Geräten automatisch herunter."}},"ja":{"stringUnit":{"state":"translated","value":"履歴同期はデバイスごとに任意です。音声同期は新しい項目に適用され、有効なデバイスに自動的にダウンロードされます。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每台设备都可单独选择是否同步历史记录。音频同步适用于新条目，并会自动下载到已启用的设备。"}},"vi":{"stringUnit":{"state":"translated","value":"Đồng bộ lịch sử là tùy chọn trên từng thiết bị. Đồng bộ âm thanh áp dụng cho các mục mới và tự động tải xuống trên các thiết bị đã bật."}}}},
    "iPad App" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"iPad-App"}},"ja":{"stringUnit":{"state":"translated","value":"iPadアプリ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"iPad App"}},"vi":{"stringUnit":{"state":"translated","value":"Ứng dụng iPad"}}}},
    "iPhone App" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"iPhone-App"}},"ja":{"stringUnit":{"state":"translated","value":"iPhoneアプリ"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"iPhone App"}},"vi":{"stringUnit":{"state":"translated","value":"Ứng dụng iPhone"}}}},
    "Mac Dictation" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Mac-Diktat"}},"ja":{"stringUnit":{"state":"translated","value":"Macの音声入力"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Mac 听写"}},"vi":{"stringUnit":{"state":"translated","value":"Mac Đọc chính tả"}}}},
    "Windows Dictation" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Windows-Diktat"}},"ja":{"stringUnit":{"state":"translated","value":"Windowsの音声入力"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Windows 听写"}},"vi":{"stringUnit":{"state":"translated","value":"Windows Đọc chính tả"}}}},
    "Windows" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Windows"}},"ja":{"stringUnit":{"state":"translated","value":"Windows"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Windows"}},"vi":{"stringUnit":{"state":"translated","value":"Windows"}}}},
    "Recorder" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Recorder"}},"ja":{"stringUnit":{"state":"translated","value":"レコーダー"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"录音"}},"vi":{"stringUnit":{"state":"translated","value":"Trình ghi âm"}}}},
    "More History Options" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Weitere Verlaufsoptionen"}},"ja":{"stringUnit":{"state":"translated","value":"その他の履歴オプション"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"更多历史记录选项"}},"vi":{"stringUnit":{"state":"translated","value":"Tùy chọn lịch sử khác"}}}},
    "No Failed Entries" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Keine fehlgeschlagenen Einträge"}},"ja":{"stringUnit":{"state":"translated","value":"失敗した項目はありません"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有失败的条目"}},"vi":{"stringUnit":{"state":"translated","value":"Không có mục nào bị lỗi"}}}},
    "Save Changes?" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Änderungen speichern?"}},"ja":{"stringUnit":{"state":"translated","value":"変更を保存しますか？"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保存更改？"}},"vi":{"stringUnit":{"state":"translated","value":"Lưu Changes?"}}}},
    "Save or discard your changes before leaving this entry." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Speichere oder verwirf deine Änderungen, bevor du diesen Eintrag verlässt."}},"ja":{"stringUnit":{"state":"translated","value":"この項目を離れる前に変更を保存または破棄してください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"离开此条目前，请保存或放弃更改。"}},"vi":{"stringUnit":{"state":"translated","value":"Lưu hoặc hủy các thay đổi của bạn trước khi rời khỏi mục này."}}}},
    "Smart Mailboxes" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Intelligente Postfächer"}},"ja":{"stringUnit":{"state":"translated","value":"スマートメールボックス"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"智能邮箱"}},"vi":{"stringUnit":{"state":"translated","value":"Hộp thư thông minh"}}}},
    "Enable the integration to open this page." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aktiviere die Integration, um diese Seite zu öffnen."}},"ja":{"stringUnit":{"state":"translated","value":"このページを開くには、プラグインを有効にしてください。"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"启用集成后即可打开此页面。"}},"vi":{"stringUnit":{"state":"translated","value":"Bật tích hợp để mở trang này."}}}},
    "Integration Unavailable" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Integration nicht verfügbar"}},"ja":{"stringUnit":{"state":"translated","value":"プラグインを利用できません"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"集成不可用"}},"vi":{"stringUnit":{"state":"translated","value":"Tích hợp không khả dụng"}}}},
    "calendarMeeting.settings.howItWorks" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Erkennung nutzt die Audioaktivität von Meeting-Apps und Meeting-URLs, auch in Hintergrund-Tabs. Bei mehrdeutigen Browser-Meetings startet keine Aufnahme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detection uses meeting app audio activity and meeting URLs, including background tabs. Ambiguous browser meetings do not start a recording."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検出にはミーティングアプリの音声使用状況と、バックグラウンドのタブを含むミーティングURLを使用します。ブラウザのミーティングを特定できない場合は録音を開始しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测会使用会议应用的音频活动和会议网址，包括后台标签页。无法明确识别浏览器中的会议时，不会开始录音。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính năng phát hiện sử dụng hoạt động âm thanh từ ứng dụng cuộc họp và URL cuộc họp, bao gồm cả các tab chạy ngầm. Các cuộc họp trên trình duyệt không xác định rõ sẽ không tự động ghi âm."
          }
        }
      }
    },
    "Visual Keyboard" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visuelle Tastatur"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビジュアルキーボード"
          }
        },
