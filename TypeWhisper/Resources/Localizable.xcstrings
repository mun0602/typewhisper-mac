        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa thiết bị này khỏi danh sách đồng bộ?"
          }
        }
      }
    },
    "Synchronized entries remain in your private sync folder. The device will reappear if it syncs again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisierte Einträge bleiben in deinem privaten Synchronisierungsordner. Das Gerät erscheint wieder, sobald es erneut synchronisiert."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期済みの項目はプライベート同期フォルダに残ります。デバイスが再び同期すると再表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已同步的条目会保留在你的私有同步文件夹中。设备再次同步时会重新出现。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các mục đã đồng bộ vẫn nằm trong thư mục đồng bộ riêng của bạn. Thiết bị sẽ xuất hiện lại nếu đồng bộ sau."
          }
        }
      }
    },
