        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể cập nhật các tiện ích mở rộng này: %@. Các bản cập nhật thành công vẫn được cài đặt. TypeWhisper chưa được khởi động lại."
          }
        }
      }
    },
    "This engine avoids repeated live API calls and transcribes the full recording after you stop." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエンジンはライブAPI呼び出しの繰り返しを避け、停止後に録音全体を文字起こします。"
