{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCalendarsFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper verwendet die ausgewählten Kalender, um an Meetings zu erinnern und bei Aktivierung Aufnahmen nach einem passenden Beitrittssignal zu starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper uses your selected calendars to remind you about meetings and, when enabled, start recordings after a matching live join signal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisperは選択したカレンダーで会議を通知し、有効な場合は一致する参加シグナルの後に録音を開始します。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper dùng lịch bạn chọn để nhắc cuộc họp và, khi được bật, bắt đầu ghi sau tín hiệu tham gia khớp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper 使用你选择的日历提醒会议，并在启用后于匹配的加入信号出现时开始录音。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper benötigt Mikrofonzugriff für die Sprache-zu-Text-Transkription."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper needs microphone access for speech-to-text transcription."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisperは音声を文字に変換するためにマイクへのアクセスが必要です。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper cần quyền micrô để phiên âm giọng nói thành chữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TypeWhisper 需要麦克风权限才能将语音转录为文字。"
          }
        }
      }
    }
  },
  "version" : "1.0"
